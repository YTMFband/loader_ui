		MenuPaint = function(open)
			if FillMode then
				-- иконка на всю кнопку: фон не заливаем, открытое меню = яркое толстое кольцо
				Gui.BackgroundTransparency = 1;

				NeverLose.PlayAnimate(Stroke , SlowyTween , {
					Thickness = open and 2.5 or 1.5,
					Transparency = open and 0 or 0.45,
				});

				NeverLose.PlayAnimate(Halo , SlowyTween , { Transparency = open and 0.72 or 1 }); -- свечение при открытом меню
			else
				NeverLose.PlayAnimate(Stroke , SlowyTween , {
					Thickness = 1.5,
					Transparency = 0,
				});

				NeverLose.PlayAnimate(Halo , SlowyTween , { Transparency = 1 });

				NeverLose.PlayAnimate(Gui , SlowyTween , {
					BackgroundColor3 = open and NeverLose.AccentColor or NeverLose.Theme.Deep2,
					BackgroundTransparency = open and 0.1 or Cfg().Transparency,
				});
			end;
		end;

		Mobile:StyleMenuButton();

		-- "Done" для режима редактирования
		DonePill = Instance.new('TextButton');
		DonePill.Name = NeverLose.RandomString();
		DonePill.Parent = Holder;
		DonePill.AnchorPoint = Vector2.new(0.5 , 0);
		DonePill.AutoButtonColor = false;
		DonePill.BackgroundColor3 = NeverLose.AccentColor;
		DonePill.BackgroundTransparency = 0.1;
		DonePill.BorderSizePixel = 0;
		DonePill.Position = UDim2.new(0.5 , 0 , 0 , 12);
		DonePill.Size = UDim2.fromOffset(110 , 30);
		DonePill.ZIndex = 165;
		DonePill.Font = Enum.Font.GothamMedium;
		DonePill.Text = 'Done';
		DonePill.TextColor3 = NeverLose.Theme.Text;
		DonePill.TextSize = 13;
		DonePill.Visible = false;

		local PillCorner = Instance.new('UICorner');
		PillCorner.CornerRadius = UDim.new(0 , 15);
		PillCorner.Parent = DonePill;

		NeverLose:AddSignal(DonePill.Activated:Connect(function()
			Mobile:SetEdit(false);
		end));

		-- нажатие = открыть/закрыть меню; перетаскивание = двигать с прилипанием к краю; удержание 0.6с = режим Edit
		local startCenter = Vector2.zero;
		local moved , pressed , longFired = false , false , false;

		bindPointer(Gui ,
			function()
				moved , pressed , longFired = false , true , false;
				startCenter = center(Gui);

				task.delay(0.6 , function()
					if pressed and not moved then
						longFired = true;
						Mobile:SetEdit(not Mobile.Edit);
					end;
				end);
			end ,
			function(delta)
				if delta.Magnitude > 8 then
					moved = true;
				end;

				if moved then
					moveTo(Gui , startCenter + delta);
				end;
			end ,
			function()
				pressed = false;

				if moved then
					local c = center(Gui);
					local vp , ml , mt , mr , mb = safeRect();
					local hv = Holder.AbsoluteSize;
					local half = Gui.AbsoluteSize / 2;
					local x = (c.X < vp.X / 2) and (ml + half.X) or (vp.X - mr - half.X);
					local y = math.clamp(c.Y , mt + half.Y , math.max(mt + half.Y , vp.Y - mb - half.Y));

					saveLayout('__menu' , x / hv.X , y / hv.Y);

					NeverLose.PlayAnimate(Gui , SlowyTween , {
						Position = UDim2.fromScale(x / hv.X , y / hv.Y),
					});
				elseif not longFired and NeverLose.CurrentWindow then
					NeverLose.CurrentWindow:ToggleInterface();
				end;
			end
		);

		if win and win.Signal then
			win.Signal:Connect(function()
				Mobile:Refresh();
			end);
		end;

		-- сторож: если кнопка каким-то образом оказалась за экраном, раз в секунду возвращаем её
		task.spawn(function()
			while MenuBtn and MenuBtn.Gui.Parent do
				task.wait(1);
				Mobile:ClampAll();
			end;
		end);

		Mobile:Refresh();
	end;

	----------------------------------------------------------------- edit mode / reset / setters
	function Mobile:SetEdit(v)
		v = v and true or false;

		if Mobile.Edit == v then
			return;
		end;

		Mobile.Edit = v;

		local win = NeverLose.CurrentWindow;

		-- при входе в Edit закрываем меню, чтобы были видны кнопки
		if v and win and win.Signal and win.Signal:GetValue() then
			win:ToggleInterface();
		end;

		for _ , b in next , Mobile.Buttons do
			paintButton(b);
		end;

		Mobile:Refresh();

		if Mobile.EditToggle and Mobile.EditToggle.SetValue then
			pcall(Mobile.EditToggle.SetValue , Mobile.EditToggle , v);
		end;
	end;

	function NeverLose:SetMobileEditMode(v)
		Mobile:SetEdit(v);
	end;

	function NeverLose:ResetMobileLayout()
		table.clear(Mobile.Layout);
		Mobile:Restyle();
	end;

	function NeverLose:SetMobileButtonSize(w , h)
		local c = Cfg();

		c.ButtonSize = Vector2.new(w or c.ButtonSize.X , h or c.ButtonSize.Y);
		Mobile:Restyle();
	end;

	function NeverLose:SetMobileShowMode(v)
		Cfg().ShowMode = v and true or false;
		Mobile:Restyle();
	end;

	function NeverLose:SetMobileCorner(r)
		Cfg().ButtonCorner = r;
		Mobile:Restyle();
	end;

	function NeverLose:SetMobileMenuButton(size , corner)
		local c = Cfg();

		c.MenuButtonSize = size or c.MenuButtonSize;
		if corner then
			if FillMode then
				c.MenuButtonFillCorner = corner;
			else
				c.MenuButtonCorner = corner;
			end;
		end;

		Mobile:Restyle();
	end;

	-- своя иконка: NeverLose:SetMobileMenuIcon('rbxassetid://123') / ('icon:menu') / ('N') ; color необязателен
	function NeverLose:SetMobileMenuIcon(icon , color , scale)
		local c = Cfg();

		c.MenuButtonIcon = icon;

		if color ~= nil then
			c.MenuButtonIconColor = color;
		end;

		if scale ~= nil then
			c.MenuButtonIconScale = scale;
		end;

		Mobile:ApplyMenuIcon();
	end;

	-- 'Auto' | 'Fill' | 'Default'
	function NeverLose:SetMobileMenuStyle(style)
		Cfg().MenuButtonStyle = style;
		Mobile:ApplyMenuIcon();
	end;

	-- позиции кнопок сохраняются в конфиг
	NeverLose.Flags['MobileLayout'] = {
		GetValue = function()
			local copy = {};

			for k , v in next , Mobile.Layout do
				copy[k] = { x = v.x , y = v.y };
			end;

			return copy;
		end,
		SetValue = function(_ , data)
			if type(data) ~= 'table' then
				return;
			end;

			table.clear(Mobile.Layout);

			for k , v in next , data do
				if type(v) == 'table' and type(v.x) == 'number' and type(v.y) == 'number' then
					Mobile.Layout[k] = { x = v.x , y = v.y };
				end;
			end;

			Mobile:Restyle();
		end,
	};
end;

