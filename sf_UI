			MobileShowMode = nil,          -- true/false: показывать Hold/Toggle на кнопке
			AllowModeChange = true,        -- true: ПКМ-меню даёт менять режим; false: в меню только Reset
			Flag = nil
		});

		local Modes = { Hold = true , Toggle = true , Always = true , Once = true };

		if not Modes[Config.Mode] then
			Config.Mode = 'Hold';
		end;

		local KeybindLib = {};
		-- клавиша хранится строкой (так её можно сохранить в конфиг), запрещённые клавиши отбрасываем
		if typeof(Config.Default) == 'EnumItem' then
			Config.Default = Config.Default.Name;
		end;

		if NeverLose:IsKeyBlocked(Config.Default) then
