		local function colorTag(color , text)
			return string.format('<font color="rgb(%d,%d,%d)">%s</font>' ,
				math.floor(color.R * 255) , math.floor(color.G * 255) , math.floor(color.B * 255) , text);
		end;

		local function getPriorityName(player)
			if player == LocalPlayer then
				return 'Client';
			end;

			return PriorityMap[tostring(player.UserId)] or 'Neutral';
		end;

		-- crew: ID из player.DataFolder.Information.Crew.Value, название из GroupService (кэш в NeverLose.CrewNames)
		local GroupService = game:GetService('GroupService');
		local CrewPending = {};
		local refreshCrews = nil;

		local function getCrewId(player)
			local data = player and player:FindFirstChild('DataFolder');
			local info = data and data:FindFirstChild('Information');
			local crew = info and info:FindFirstChild('Crew');

			if not crew or not crew:IsA('ValueBase') then
				return nil;
			end;

			local id = tonumber(crew.Value);

			if id and id > 0 then
				return math.floor(id);
			end;

			return nil;
		end;

		local function requestCrew(id)
			if NeverLose.CrewNames[id] or CrewPending[id] then
				return;
			end;

			CrewPending[id] = true;

			task.spawn(function()
				local ok , info = pcall(GroupService.GetGroupInfoAsync , GroupService , id);

				CrewPending[id] = nil;

				-- если название не получили, показываем ID (чтобы не повторять запрос бесконечно)
				NeverLose.CrewNames[id] = (ok and info and info.Name) or ('#' .. tostring(id));

				if refreshCrews then
					refreshCrews();
				end;
			end);
		end;

		local function getCrewText(player)
			local id = getCrewId(player);

			if not id then
				return 'No crew';
			end;

			if NeverLose.CrewNames[id] then
				return NeverLose.CrewNames[id];
			end;

			requestCrew(id);

			return 'Loading...';
		end;

		local function priorityColor(name)
			if name == 'Client' then
				return NeverLose.AccentColor;
			end;

			if name == 'Whitelist' then
				return WhitelistColor;
			end;

			return NeutralColor;
		end;

		local function matchesSearch(player)
			if Search == '' then
				return true;
			end;

			if string.find(string.lower(player.Name) , Search , 1 , true) ~= nil
				or string.find(string.lower(player.DisplayName) , Search , 1 , true) ~= nil then
				return true;
			end;

			local id = getCrewId(player);

			if not id then
				return false;
			end;

			if string.find(tostring(id) , Search , 1 , true) then
				return true;
			end;

			local name = NeverLose.CrewNames[id];

			return name ~= nil and string.find(string.lower(name) , Search , 1 , true) ~= nil;
		end;

		local Viewing = nil;

		local function updateButtons()
			local locked = (Selected == nil) or (Selected == LocalPlayer);
			local whitelisted = (Selected ~= nil) and getPriorityName(Selected) == 'Whitelist';
			local viewing = (Selected ~= nil) and Viewing == Selected;

			for name , b in next , PriorityButtons do
				local active = (name == 'Whitelist' and whitelisted) or (name == 'View' and viewing);
				local color = (name == 'Whitelist') and WhitelistColor or NeverLose.AccentColor;

				NeverLose.PlayAnimate(b.Button , SlowyTween , {
					BackgroundColor3 = active and color or NeverLose.Theme.Deep,
					BackgroundTransparency = active and 0.7 or 0,
				});

				NeverLose.PlayAnimate(b.Stroke , SlowyTween , {
					Color = active and color or NeverLose.Theme.Stroke,
					Transparency = active and 0.3 or 0.65,
				});

				b.Button.TextColor3 = active and color or NeverLose.Theme.TextDim;
				b.Button.TextTransparency = locked and 0.7 or 0.1;
			end;
		end;

