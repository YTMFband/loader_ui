NeverLose.GetCalculatePosition = LPH_NO_VIRTUALIZE(function(planePos, planeNormal, rayOrigin, rayDirection)
	local n = planeNormal;
	local d = rayDirection;
	local v = rayOrigin - planePos;

	local num = (n.x * v.x) + (n.y * v.y) + (n.z * v.z);
	local den = (n.x * d.x) + (n.y * d.y) + (n.z * d.z);
	local a = -num / den;

	return rayOrigin + (a * rayDirection);
end);

NeverLose.CreateBlurModule = LPH_NO_VIRTUALIZE(function(self , Frame , Signal)
	if not NeverLose.EnabledBlur then
		return NeverLose:AddSignal(Instance.new('BindableEvent').Event:Connect(function() return "nl"; end));	
	end;

	local Part = Instance.new('Part',NeverLose.BlurModuleParent);
	local DepthOfField = Instance.new('DepthOfFieldEffect',cloneref(game:GetService('Lighting')));
	local BlockMesh = Instance.new("BlockMesh");

	BlockMesh.Parent = Part;

	Part.Material = Enum.Material.Glass;
	Part.Transparency = 1;
	Part.Reflectance = 1;
	Part.CastShadow = false;
	Part.Anchored = true;
	Part.CanCollide = false;
	Part.CanQuery = false;
	Part.CollisionGroup = NeverLose.RandomString();
	Part.Size = Vector3.new(1, 1, 1) * 0.01;
	Part.Color = Color3.fromRGB(0,0,0);

	DepthOfField.Enabled = true;
	DepthOfField.FarIntensity = 0;
	DepthOfField.FocusDistance = 0;
	DepthOfField.InFocusRadius = 1000;
	DepthOfField.NearIntensity = 1;
	DepthOfField.Name = NeverLose.RandomString();

	Part.Name = NeverLose.RandomString();

	local lastActive , lastCFrame , lastPos , lastSize , lastFov , lastViewport;
	local FadeInfo = TweenInfo.new(0.1);

	local UpdateFunction = function()
		local Camera = workspace.CurrentCamera or CurrentCamera;
		local IsWindowActive = Signal:GetValue() and not NeverLose.Global3DRenderMode;

		if not IsWindowActive then
			-- already hidden: nothing to do (previously this re-ran tweens 10x/second)
			if lastActive == false then
				return false;
			end;

			lastActive = false;
			lastCFrame = nil;

			NeverLose.PlayAnimate(DepthOfField,FadeInfo,{
				NearIntensity = 0
			});

			NeverLose.PlayAnimate(Part,FadeInfo,{
				Size = Vector3.zero,
				Transparency = 1.5,
			});

			Part.Parent = nil;

			return false;
		end;

		if lastActive ~= true then
			lastActive = true;

			NeverLose.PlayAnimate(DepthOfField,FadeInfo,{
				NearIntensity = 1
			});

			NeverLose.PlayAnimate(Part,FadeInfo,{
				Transparency = 0.97,
				Size = Vector3.new(1, 1, 1) * 0.01;
			});

			Part.Parent = NeverLose.BlurModuleParent;
		end;

		local cframe , pos , size , fov , viewport = Camera.CFrame , Frame.AbsolutePosition , Frame.AbsoluteSize , Camera.FieldOfView , Camera.ViewportSize;

		-- camera and window did not move: skip the whole projection math
		if cframe == lastCFrame and pos == lastPos and size == lastSize and fov == lastFov and viewport == lastViewport then
			return;
		end;

		lastCFrame , lastPos , lastSize , lastFov , lastViewport = cframe , pos , size , fov , viewport;

		local corner0 = pos;
		local corner1 = corner0 + size;

		local ray0 = Camera.ScreenPointToRay(Camera,corner0.X, corner0.Y, 1);
		local ray1 = Camera.ScreenPointToRay(Camera,corner1.X, corner1.Y, 1);

		local planeOrigin = cframe.Position + cframe.LookVector * (0.05 - Camera.NearPlaneZ);
		local planeNormal = cframe.LookVector;

		local pos0 = NeverLose.GetCalculatePosition(planeOrigin, planeNormal, ray0.Origin, ray0.Direction);
		local pos1 = NeverLose.GetCalculatePosition(planeOrigin, planeNormal, ray1.Origin, ray1.Direction);

		pos0 = cframe:PointToObjectSpace(pos0);
		pos1 = cframe:PointToObjectSpace(pos1);

		BlockMesh.Offset = (pos0 + pos1) / 2;
		BlockMesh.Scale  = (pos1 - pos0) / 0.0101;
		Part.CFrame = cframe;
	end;

	-- single per-frame connection that early-outs when nothing changed
	local rbxsignal = NeverLose:AddSignal(RunService.RenderStepped:Connect(function()
		pcall(UpdateFunction);
	end));

	local destroyed = false;
	local disconnect = function()
		if destroyed then
			return;
		end;

		destroyed = true;

		rbxsignal:Disconnect();
		Part:Destroy();
		DepthOfField:Destroy();
	end;

	Frame.Destroying:Connect(disconnect);

	return rbxsignal;
end);

