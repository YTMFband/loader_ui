do
	-- text measurements are an engine call; the same strings get measured again and again
	local cache , size = {} , 0;
	local huge = Vector2.new(math.huge , math.huge);

	NeverLose.GetTextSize = function(text , fontSize , font , bounds)
		if bounds ~= huge and bounds ~= nil and (bounds.X ~= math.huge or bounds.Y ~= math.huge) then
			return TextService:GetTextSize(text , fontSize , font , bounds);
		end;

		local key = tostring(text)..'\0'..tostring(fontSize)..'\0'..tostring(font);
		local hit = cache[key];

		if hit then
			return hit;
		end;

		if size >= 600 then
			table.clear(cache);
			size = 0;
		end;

		hit = TextService:GetTextSize(text , fontSize , font , huge);
		cache[key] = hit;
		size += 1;

		return hit;
	end;
end;

