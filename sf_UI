function NeverLose:IsKeyBlocked(key)
	if typeof(key) == 'EnumItem' then
		key = key.Name;
	end;

	if type(key) ~= 'string' or key == '' or key == 'None' or key == 'M1B' or key == 'M2B' then
		return false;
	end;

	if NeverLose.KeyBlacklist[key] or key == 'Unknown' then
		return true;
	end;

	-- кнопки геймпада и прочее, что не является клавишей клавиатуры
	if string.sub(key , 1 , 6) == 'Button' or string.sub(key , 1 , 10) == 'Thumbstick' or string.sub(key , 1 , 4) == 'DPad' or string.sub(key , 1 , 5) == 'World' then
		return true;
	end;

	-- клавиша открытия меню (по умолчанию Insert)
	local win = NeverLose.CurrentWindow;
	local menuKey = win and win.Keybind;

	if typeof(menuKey) == 'EnumItem' then
		menuKey = menuKey.Name;
	end;

	return menuKey ~= nil and menuKey == key;
end;

