NeverLose.ProcessParams = LPH_NO_VIRTUALIZE(function(self , Params , Fixed)
	Params = Params or {};

	local k = Params or {};

	for i,v in next , Fixed do
		local given = Params[i];

		if given == nil or (type(v) == 'function' and type(given) ~= 'function') then
			k[i] = v;
		end;
	end;

	table.clear(Fixed);

	return k;
end);

