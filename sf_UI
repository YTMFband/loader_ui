		function ConfigLib:GetData(performance)
			local ikc = {};
			local skipped = {};
			
			local cd = 0;
			for Flag,v in next , NeverLose.Flags do
				if v and v.GetValue then
					local gok , data = pcall(v.GetValue , v);

					if not gok then
						table.insert(skipped , Flag .. ' (GetValue error)');
					elseif typeof(data) == 'Color3' then
						table.insert(ikc,{
							Idx = Flag,
							Value = data:ToHex(),
						});
					else
						-- проверяем, что значение кодируется в JSON (NaN, inf, функции и т.п. не кодируются)
						local eok = pcall(HttpService.JSONEncode , HttpService , { Value = data });

						if eok then
							table.insert(ikc,{
								Idx = Flag,
								Value = data
							});
						else
							table.insert(skipped , Flag .. ' (value cannot be saved)');
						end;
					end;
				end;
				
				if performance then
					if cd % 35 == 1 then
						task.wait()
					end
				end;
				
				cd += 1;
			end;

			local okj , json = pcall(HttpService.JSONEncode , HttpService , ikc);

			if not okj then
				return nil , 'encode failed: ' .. tostring(json);
			end;

			return NeverLose.Base64Encode(Encryption.new(json)) , skipped;
		end;

		-- запись конфига: при ошибке показываем сообщение с причиной (не молча)
		function ConfigLib:Write(path)
			local gok , data , info = pcall(ConfigLib.GetData , ConfigLib);

			if not gok then
				Logging.new("folder" , 'Config not saved: ' .. tostring(data) , 6);
				return false;
			end;

			if not data then
				Logging.new("folder" , 'Config not saved: ' .. tostring(info) , 6);
				return false;
			end;

			if info and #info > 0 then
				Logging.new("folder" , 'Skipped: ' .. table.concat(info , ', ') , 6);
			end;

			local wok , werr = pcall(writefile , path , data);

			if not wok then
				Logging.new("folder" , 'Write failed: ' .. tostring(werr) , 6);
				return false;
			end;

			return true;
		end;

		function ConfigLib:LoadData(data)
			local coded = HttpService:JSONDecode(Encryption.reverse(NeverLose.Base64Decode(data)));

			for i,v in next , coded do
				if v.Idx then
					if NeverLose.Flags[v.Idx] then
						task.spawn(function()
							NeverLose.Flags[v.Idx]:SetValue(v.Value)
						end)
					end;
				end;
			end;
		end;

