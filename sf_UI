				InfoPriority.Text = label('Priority' , '-');
				InfoTeam.Text = label('Crew' , '-');
				updateButtons();
				return;
			end;

			local name = getPriorityName(Selected);

			InfoName.Text = label('Name' , string.format('%s (%s)' , Selected.DisplayName , Selected.Name));
			InfoPriority.Text = label('Priority' , colorTag(priorityColor(name) , name));
			InfoTeam.Text = label('Crew' , getCrewText(Selected));
			Avatar.Image = Thumbs[Selected.UserId] or '';
