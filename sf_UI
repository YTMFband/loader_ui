do
	local SURFACE = { 'Main' , 'Card' , 'Elem' , 'Elem2' , 'Hover' , 'Field' , 'Deep' , 'Deep2' , 'Track' , 'Stroke' , 'Accent' };
	local TEXTS = { 'Text' , 'Icon' , 'TextDim' , 'TextMute' , 'Accent' };

	-- расстояние между цветами (сумма разниц каналов, 0..3)
	local function dist(a , b)
		return math.abs(a.R - b.R) + math.abs(a.G - b.G) + math.abs(a.B - b.B);
	end;

	-- допуск: цвет, близкий к роли старой темы, считается этой ролью (0.12 ~ 30/255 по сумме каналов)
	local MATCH_LIMIT = 0.12;

	local function nearestRole(c , old , roles)
		local best , bestD = nil , MATCH_LIMIT;

		for _ , r in next , roles do
			local oc = old[r];

			if oc then
				local d = dist(c , oc);

				if d <= bestD then
					best , bestD = r , d;
				end;
			end;
		end;

		return best;
	end;

	-- перекрашивает уже созданные элементы АВТОМАТИЧЕСКИ: цвет, близкий к роли старой темы,
	-- получает такую же роль новой темы. Элементам вручную привязывать не нужно.
	local function recolor(old)
		local new = NeverLose.Theme;

		local function fix(inst , prop , roles)
			local ok , cur = pcall(function()
				return inst[prop];
			end);

			if not ok or typeof(cur) ~= 'Color3' then
				return;
			end;

			local r = nearestRole(cur , old , roles);

			if r and new[r] and new[r] ~= cur then
				inst[prop] = new[r];
			end;
		end;

		task.spawn(function()
			local n = 0;

			for _ , d in next , NeverLose.ScreenGui:GetDescendants() do
				if d:IsA('GuiObject') then
					fix(d , 'BackgroundColor3' , SURFACE);
				end;

				if d:IsA('TextLabel') or d:IsA('TextButton') or d:IsA('TextBox') then
					fix(d , 'TextColor3' , TEXTS);
				end;

				if d:IsA('TextBox') then
					fix(d , 'PlaceholderColor3' , TEXTS);
				end;

				if d:IsA('ImageLabel') or d:IsA('ImageButton') then
					fix(d , 'ImageColor3' , TEXTS);
				end;

				if d:IsA('UIStroke') then
					fix(d , 'Color' , SURFACE);
				end;

				if d:IsA('ScrollingFrame') then
					fix(d , 'ScrollBarImageColor3' , SURFACE);
				end;

				n += 1;

				if n % 300 == 0 then
					task.wait();
				end;
			end;
		end);
	end;

	NeverLose.ThemeListeners = NeverLose.ThemeListeners or {};

	-- имя темы из NeverLose.Themes или своя таблица ролей (недостающие роли остаются текущими)
	function NeverLose:SetTheme(theme)
		local data = (type(theme) == 'string') and NeverLose.Themes[theme] or theme;

		if type(data) ~= 'table' then
			return false;
		end;

		local old = {};

		for k , v in next , NeverLose.Theme do
			old[k] = v;
		end;

		for k , v in next , data do
			if typeof(v) == 'Color3' then
				NeverLose.Theme[k] = v;
			end;
		end;

		NeverLose.AccentColor = NeverLose.Theme.Accent;
		NeverLose.MainColor = NeverLose.Theme.Main;
		NeverLose.CurrentTheme = (type(theme) == 'string') and theme or 'Custom';

		recolor(old);

		-- элементы, которым нужно пересчитать цвета самим (например, кнопки)
		for i = #NeverLose.ThemeListeners , 1 , -1 do
			local ok , keep = pcall(NeverLose.ThemeListeners[i]);

			if not ok or keep == false then
				table.remove(NeverLose.ThemeListeners , i);
			end;
		end;

		return true;
	end;

	function NeverLose:SetAccent(color)
		return NeverLose:SetTheme({ Accent = color });
	end;

	-- привязывает свойство элемента к роли темы: при каждом SetTheme значение обновится само.
	-- Вызывать ПОСЛЕ того, как элемент получил Parent (иначе слушатель сразу удалится).
	-- Пример: NeverLose:BindTheme(myFrame, 'BackgroundColor3', 'Main')
	function NeverLose:BindTheme(Inst, Prop, Role)
		local function apply()
			if not Inst.Parent then
				return false;
			end;

			local c = NeverLose.Theme[Role];

			if c and Inst[Prop] ~= c then
				Inst[Prop] = c;
			end;
		end;

		apply();
		table.insert(NeverLose.ThemeListeners , apply);

		return Inst;
	end;

	function NeverLose:AddTheme(name , roles)
		NeverLose.Themes[name] = roles;
	end;

	function NeverLose:GetThemeNames()
		local names = {};

		for n in next , NeverLose.Themes do
			table.insert(names , n);
		end;

		table.sort(names);

		return names;
	end;
end;
