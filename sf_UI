		-------------------------------------------------------------- state
		local function resolveName()
			if Config.Name then
				return Config.Name;
			end;

			local parent = Handler.Parent;

			if parent then
				for _ , v in next , parent:GetChildren() do
					if v:IsA('TextLabel') and v.Text ~= '' then
						return v.Text;
					end;
				end;
			end;

			return 'Keybind';
		end;

		KeybindLib.Name = resolveName();
		KeybindLib.FlagName = Config.Flag;
		KeybindLib.Mode = Config.Mode;
		KeybindLib.Active = (Config.Mode == 'Always');
		KeybindLib.ShowInList = Config.ShowInList;
		KeybindLib.Changed = NeverLose:CreateSignal(0);

		local function fireChanged()
			KeybindLib.Changed:SetValue(KeybindLib.Changed:GetValue() + 1);
		end;

		local function keyName()
			local k = Config.Default;

			if typeof(k) == 'EnumItem' then
				return k.Name;
			end;

			return k;
		end;

		local function setActive(v)
			v = v and true or false;

			if KeybindLib.Active == v then
				return;
			end;

			KeybindLib.Active = v;
			fireChanged();
			task.spawn(Config.StateCallback , v);
		end;

		function KeybindLib:GetState()
			return KeybindLib.Active;
		end;

		-- Once: один вызов StateCallback(true) за нажатие, без включено/выключено; строка в списке коротко мигает
		local function fireOnce()
			KeybindLib.Active = true;
			fireChanged();
			task.spawn(Config.StateCallback , true);

			task.delay((Config.FlashTime or 0.25) , function()
				KeybindLib.Active = false;
				fireChanged();
			end);
		end;

		-- то же, что нажатие / отпускание клавиши (используют экранные кнопки)
		function KeybindLib:Press()
			if KeybindLib.Mode == 'Always' then
				return;
			end;

			if KeybindLib.Mode == 'Once' then
				fireOnce();
				return;
			end;

			if KeybindLib.Mode == 'Toggle' then
				setActive(not KeybindLib.Active);
			else
				setActive(true);
			end;
		end;

		function KeybindLib:Release()
			if KeybindLib.Mode == 'Hold' and KeybindLib.Active then
				setActive(false);
			end;
		end;

		function KeybindLib:GetMode()
			return KeybindLib.Mode;
		end;

		function KeybindLib:SetName(n)
			KeybindLib.Name = n;
			fireChanged();
		end;

		function KeybindLib:SetMode(m)
			if not Modes[m] then
				return;
			end;

			KeybindLib.Mode = m;
			fireChanged();

			if m == 'Always' then
				setActive(true);
			else
				setActive(false);
			end;
		end;

		KeybindLib.SetRender = LPH_NO_VIRTUALIZE(function(value)
			if value then
				NeverLose.PlayAnimate(Keybind,SlowyTween, {
					BackgroundTransparency = 0
				})

				NeverLose.PlayAnimate(UIStroke,SlowyTween, {
					Transparency = 0.650
				})

				NeverLose.PlayAnimate(ValueLabel,SlowyTween, {
					TextTransparency = 0.500
				})
			else
				NeverLose.PlayAnimate(Keybind,SlowyTween, {
					BackgroundTransparency = 1
				})

				NeverLose.PlayAnimate(UIStroke,SlowyTween, {
					Transparency = 1
				})

				NeverLose.PlayAnimate(ValueLabel,SlowyTween, {
					TextTransparency = 1
				})
			end;
		end);

		function KeybindLib:Update()
			local size = NeverLose.GetTextSize(ValueLabel.Text,ValueLabel.TextSize,ValueLabel.Font,Vector2.new(math.huge,math.huge));

			NeverLose.PlayAnimate(Keybind , SlowyTween , {
				Size = UDim2.new(0, size.X + 7, 0, 18)
			})
		end;

		local IsBlacklist = LPH_NO_VIRTUALIZE(function(v)
			return Config.Blacklist and (Config.Blacklist[v] or table.find(Config.Blacklist,v))
		end);

		KeybindLib:Update()

		KeybindLib.SetRender(Signal:GetValue());
		Signal:Connect(KeybindLib.SetRender);

		-------------------------------------------------------------- key press -> state
		local IsBinding = false;

		local function matches(input)
			local key = keyName();

			if not key or key == 'None' or key == '' or NeverLose:IsKeyBlocked(key) then
				return false;
			end;

			if key == 'M1B' then
				return input.UserInputType == Enum.UserInputType.MouseButton1;
			elseif key == 'M2B' then
				return input.UserInputType == Enum.UserInputType.MouseButton2;
			end;

			return input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode.Name == key;
		end;

		NeverLose:AddSignal(UserInputService.InputBegan:Connect(function(input , gp)
			if IsBinding or gp or UserInputService:GetFocusedTextBox() then
				return;
			end;

			if KeybindLib.Mode == 'Always' or not matches(input) then
				return;
			end;

			if KeybindLib.Mode == 'Once' then
				fireOnce();
				return;
			end;

			if KeybindLib.Mode == 'Toggle' then
				setActive(not KeybindLib.Active);
			else
				setActive(true);
			end;
		end));

		NeverLose:AddSignal(UserInputService.InputEnded:Connect(function(input)
			if KeybindLib.Mode == 'Hold' and KeybindLib.Active and matches(input) then
				setActive(false);
			end;
		end));

		-------------------------------------------------------------- right click menu (mode / reset)
		local Menu = nil;
		local MenuConn = nil;
		local ClosedAt = 0;
		local FlagsHeld = false;

		local function closeMenu(byOutside)
			if MenuConn then
				MenuConn:Disconnect();
				MenuConn = nil;
			end;

			if Menu then
				Menu:Destroy();
				Menu = nil;
			end;

			-- отпускаем флаги: теперь окно настроек снова может закрываться кликом снаружи
			if FlagsHeld then
				FlagsHeld = false;
				NeverLose.IsDropdownOn = false;
				NeverLose.IsMosueOverOtherFrame = false;
			end;

			if byOutside then
				ClosedAt = os.clock();
			end;
		end;

		local function openMenu()
			if Menu then
				closeMenu();
				return;
			end;

			if os.clock() - ClosedAt < 0.25 then
				return;
			end;

			local Width , Row = 96 , 22;
			local Items = Config.AllowModeChange and { 'Hold' , 'Toggle' , 'Always' , 'Reset' } or { 'Reset' };
			local Buttons = {};

			Menu = Instance.new('Frame');
			Menu.Name = NeverLose.RandomString();
			Menu.Parent = NeverLose.ScreenGui;
			Menu.BackgroundColor3 = NeverLose.MainColor;
			Menu.BackgroundTransparency = 0.05;
			Menu.BorderSizePixel = 0;
			Menu.Size = UDim2.new(0 , Width , 0 , #Items * Row + 32);
			Menu.ZIndex = 170;
			Menu.ClipsDescendants = true;

			local MenuHead = Instance.new('Frame');
			MenuHead.Parent = Menu;
			MenuHead.BackgroundColor3 = Color3.fromRGB(255 , 255 , 255);
			MenuHead.BorderSizePixel = 0;
			MenuHead.Size = UDim2.new(1 , 0 , 0 , 22);
			MenuHead.ZIndex = 171;

			local MHGrad = Instance.new('UIGradient');
			MHGrad.Color = ColorSequence.new(NeverLose.Theme.Field:Lerp(Color3.new(1 , 1 , 1) , 0.07) , NeverLose.Theme.Field);
			MHGrad.Rotation = 90;
			MHGrad.Parent = MenuHead;

			local MHText = Instance.new('TextLabel');
			MHText.Parent = MenuHead;
			MHText.BackgroundTransparency = 1;
			MHText.Position = UDim2.new(0 , 9 , 0 , 0);
			MHText.Size = UDim2.new(1 , -18 , 1 , 0);
			MHText.Font = Enum.Font.GothamMedium;
			MHText.Text = 'MODE';
			MHText.TextColor3 = NeverLose.Theme.Text;
			MHText.TextSize = 10;
			MHText.TextTransparency = 0.4;
			MHText.TextXAlignment = Enum.TextXAlignment.Left;
			MHText.ZIndex = 172;

			-- пока меню открыто, окно настроек (шестерёнка) не должно закрываться от клика по нашему меню
			FlagsHeld = true;
			NeverLose.IsDropdownOn = true;
			NeverLose.IsMosueOverOtherFrame = true;

			local abs , size = Keybind.AbsolutePosition , Keybind.AbsoluteSize;
			local view = CurrentCamera.ViewportSize;
			local x = math.clamp(abs.X + size.X - Width , 4 , math.max(4 , view.X - Width - 4));
			local y = math.clamp(abs.Y + size.Y + 4 , 4 , math.max(4 , view.Y - (#Items * Row + 14)));

			Menu.Position = UDim2.fromOffset(x , y);

			local MenuCorner = Instance.new('UICorner');
			MenuCorner.CornerRadius = UDim.new(0 , 8);
			MenuCorner.Parent = Menu;

			local MenuStroke = Instance.new('UIStroke');
			MenuStroke.Color = NeverLose.Theme.Stroke;
			MenuStroke.Transparency = 0.4;
			MenuStroke.Parent = Menu;

			local function paint()
				for name , b in next , Buttons do
					if name == 'Reset' then
						b.TextColor3 = Color3.fromRGB(240 , 90 , 90);
						b.TextTransparency = 0.15;
					else
						local on = (KeybindLib.Mode == name);

						b.TextColor3 = on and NeverLose.AccentColor or Color3.fromRGB(255 , 255 , 255);
						b.BackgroundColor3 = NeverLose.AccentColor;
						b.BackgroundTransparency = on and 0.8 or 1;
						b.TextTransparency = on and 0 or 0.35;
					end;
				end;
			end;

			for i , name in next , Items do
				local B = Instance.new('TextButton');

				B.Name = NeverLose.RandomString();
				B.Parent = Menu;
				B.AutoButtonColor = false;
				B.BackgroundColor3 = NeverLose.Theme.Elem;
				B.BackgroundTransparency = 1;
				B.BorderSizePixel = 0;
				B.Position = UDim2.new(0 , 5 , 0 , 27 + (i - 1) * Row);
				B.Size = UDim2.new(1 , -10 , 0 , Row - 2);
				B.ZIndex = 171;
				B.Font = Enum.Font.GothamMedium;
				B.Text = name;
				B.TextSize = 12;

				local BC = Instance.new('UICorner');
				BC.CornerRadius = UDim.new(0 , 5);
				BC.Parent = B;

				Buttons[name] = B;

				B.MouseEnter:Connect(function()
					NeverLose.PlayAnimate(B , SlowyTween , { BackgroundTransparency = 0.5 });
				end);

				B.MouseLeave:Connect(function()
					NeverLose.PlayAnimate(B , SlowyTween , { BackgroundTransparency = 1 });
				end);

				B.Activated:Connect(function()
					if name == 'Reset' then
						KeybindLib:Reset();
						closeMenu();
					else
						KeybindLib:SetMode(name);
						paint();
					end;
				end);
			end;

			-- разделитель перед Reset
			local Divider = Instance.new('Frame');
			Divider.Name = NeverLose.RandomString();
			Divider.Parent = Menu;
			Divider.BackgroundColor3 = NeverLose.Theme.Stroke;
			Divider.BackgroundTransparency = 0.4;
			Divider.BorderSizePixel = 0;
			Divider.Position = UDim2.new(0 , 8 , 0 , 27 + 3 * Row - 1);
			Divider.Size = UDim2.new(1 , -16 , 0 , 1);
			Divider.ZIndex = 171;
			Divider.Visible = Config.AllowModeChange and true or false;

			paint();

			MenuConn = UserInputService.InputBegan:Connect(function(input)
				local t = input.UserInputType;

				if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.Touch then
					if not Menu then
						return;
					end;

					local a , s = Menu.AbsolutePosition , Menu.AbsoluteSize;
					local p = input.Position;

					if p.X < a.X or p.X > a.X + s.X or p.Y < a.Y or p.Y > a.Y + s.Y then
						closeMenu(true);
					end;
				end;
			end);
		end;

		Signal:Connect(function(value)
			if not value then
				closeMenu();
			end;
		end);

		-------------------------------------------------------------- bind button
		local LongPressed = false;
		local PressId = 0;

		local BindButton = NeverLose:CreateInput(Keybind , function()
			if LongPressed then
				LongPressed = false;
				return;
			end;

			if IsBinding then
				return;
			end;

			closeMenu();

			IsBinding = true;

			ValueLabel.Text = "...";
			UIStroke.Color = NeverLose.AccentColor;
			UIStroke.Transparency = 0.2;

			KeybindLib:Update();

			local Selected = nil;

			while not Selected do
				local Key = UserInputService.InputBegan:Wait();

				if Key.KeyCode == Enum.KeyCode.Escape then
					Selected = 'Cancel'; -- Escape = отмена, бинд не меняется
				elseif Key.KeyCode == Enum.KeyCode.Backspace then
					Selected = 'None'; -- Backspace = очистить бинд
				elseif Key.KeyCode ~= Enum.KeyCode.Unknown and not NeverLose:IsKeyBlocked(Key.KeyCode) and not IsBlacklist(Key.KeyCode) and not IsBlacklist(Key.KeyCode.Name) then
					Selected = Key.KeyCode;
				else
					if Key.UserInputType == Enum.UserInputType.MouseButton1 and not IsBlacklist(Enum.UserInputType.MouseButton1) and not IsBlacklist("M1B") then
						Selected = "M1B";
					elseif Key.UserInputType == Enum.UserInputType.MouseButton2 and not IsBlacklist(Enum.UserInputType.MouseButton2) and not IsBlacklist("M2B") then
						Selected = "M2B";
					end;
				end;
			end;

			IsBinding = false;

			if Selected == 'Cancel' then
				ValueLabel.Text = NeverLose:KeyCodeToStr(Config.Default or "None");
				KeybindLib:Update();
				return;
			end;

			local KeyName = typeof(Selected) == "string" and Selected or Selected.Name;

			Config.Default = KeyName;

			ValueLabel.Text = NeverLose:KeyCodeToStr(KeyName);
			UIStroke.Color = NeverLose.Theme.Stroke;
			UIStroke.Transparency = 0.65;

			KeybindLib:Update();

			if KeybindLib.Mode ~= 'Always' then
				setActive(false);
			end;

			fireChanged();

			Config.Callback(KeyName)
		end)

		-- правая кнопка мыши
		NeverLose:AddSignal(BindButton.MouseButton2Click:Connect(function()
			openMenu();
		end));

		-- долгое нажатие на телефоне
		NeverLose:AddSignal(BindButton.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				PressId += 1;

				local id = PressId;

				task.delay(0.45 , function()
					if id == PressId and not IsBinding then
						LongPressed = true;
						openMenu();
					end;
				end);
			end;
		end));

		NeverLose:AddSignal(BindButton.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				PressId += 1;

				-- если после долгого нажатия клик не пришёл, флаг не должен залипнуть
				task.delay(0.15 , function()
					LongPressed = false;
				end);
			end;
		end));

		-------------------------------------------------------------- API
		function KeybindLib:GetValue()
			return Config.Default;
		end;

		function KeybindLib:SetValue(v)
			if typeof(v) == 'EnumItem' then
				v = v.Name;
			end;

			if NeverLose:IsKeyBlocked(v) then
				v = nil; -- запрещённая клавиша из старого конфига -> пусто
			end;

			Config.Default = v;
			ValueLabel.Text = NeverLose:KeyCodeToStr(v or "None");
			KeybindLib:Update();

			if KeybindLib.Mode ~= 'Always' then
				setActive(false);
			end;

			fireChanged();
			Config.Callback(Config.Default);
		end;

		-- показать / скрыть этот бинд в keybind list на лету
		function KeybindLib:SetShowInList(v)
			v = v and true or false;
			KeybindLib.ShowInList = v;

			local list = NeverLose.KeybindList;

			if v then
				if list and not KeybindLib.ListItem then
					KeybindLib.ListItem = list:Add({ Source = KeybindLib });
				end;
			elseif KeybindLib.ListItem then
				KeybindLib.ListItem:Remove();
				KeybindLib.ListItem = nil;
			end;
		end;

		function KeybindLib:Reset()
			if IsBinding then
				return;
			end;

			closeMenu();

			-- клавиша и режим возвращаются к тем, что были заданы при создании
			Config.Default = OriginalKey;
			ValueLabel.Text = NeverLose:KeyCodeToStr(OriginalKey or "None");
			KeybindLib:Update();

			KeybindLib.Mode = OriginalMode;
			KeybindLib.Active = (OriginalMode == 'Always');

			fireChanged(); -- обновляет keybind list
			task.spawn(Config.StateCallback , KeybindLib.Active);
			task.spawn(Config.Callback , OriginalKey or 'None');
		end;

		if Config.Flag then
			NeverLose.Flags[Config.Flag] = KeybindLib;

			-- режим сохраняется в конфиг отдельным флагом
			NeverLose.Flags[Config.Flag .. '_mode'] = {
				GetValue = function()
					return KeybindLib.Mode;
				end,
				SetValue = function(_ , v)
					KeybindLib:SetMode(v);
				end,
			};
		end;

		-- авто-регистрация в keybind list
		NeverLose.KeybindRegistry = NeverLose.KeybindRegistry or {};
		table.insert(NeverLose.KeybindRegistry , KeybindLib);

		if NeverLose.KeybindList and KeybindLib.ShowInList then
			KeybindLib.ListItem = NeverLose.KeybindList:Add({ Source = KeybindLib });
		end;

		-- экранная кнопка для телефона
		KeybindLib.MobileButton = nil;

		if Config.MobileButton == true then
			KeybindLib.MobileButton = NeverLose:AddMobileButton(KeybindLib , {
				Size = Config.MobileSize,
				Corner = Config.MobileCorner,
				ShowMode = Config.MobileShowMode,
				Key = Config.Flag or KeybindLib.Name,
			});
		end;

		return KeybindLib;
	end;

