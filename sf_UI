vlxtable.EnabledLabelOption = vlxtable.EnabledLabel:AddOption(1)
vlxtable.EnabledLabelOption:AddLabel('Keybind'):AddKeybind({
    Default = 'NONE',
    Flag = 'Camlock_Keybind',
    Mode = 'Toggle',
    Name = 'Keybind';
    AllowModeChange = true,
    StateCallback = function(active) 
        if active == false then
            ScriptConfiguration.AimBot.Player = nil
            return
        end
        local Distance = lConfiguration.SilentAim.Radius
        local mousepos = uis:GetMouseLocation()
        local RenderedPlayer = nil
        local RenderedPart = nil

        for index, Player in ipairs(ScriptConfiguration.Cached_Players) do
            local Character: Model = Player['Character']
            if not Character then continue end
            
            local HRP = Character:FindFirstChild('HumanoidRootPart', true)
            local Head = Character:FindFirstChild('Head', true)
            local hum = Character:FindFirstChild('Humanoid', true)
            
            if not HRP or not Head or not hum then continue end

            local partfromhitbox = Character:FindFirstChild('Head', true)
            if not partfromhitbox then continue end
            
            local newposition, vision = camera:WorldToViewportPoint(partfromhitbox.Position)
            if not vision then continue end
            local position = mousepos
            if lConfiguration.Aimbot.SetTarget == 'Screen Center' then
                position = camera.ViewportSize / 2
            end

            local newdistance = (position - Vector2.new(newposition.X, newposition.Y)).Magnitude
            if newdistance < Distance then
                if lConfiguration.Aimbot.Checks then

                    if ScriptConfiguration.WhitelistedDisplayname[Player.DisplayName] then
                        continue
                    end

                    if lConfiguration.Aimbot.ChecksConfiguration.Vision and not lfunctions.Vision(partfromhitbox) then
                        continue
                    end

                    if lConfiguration.Aimbot.ChecksConfiguration.Down then
                        if lfunctions.DownCheck(Character) then
                            continue
                        end
                    end

                    if lConfiguration.Aimbot.ChecksConfiguration.Grabbed  then
                        if Character:FindFirstChild('GRABBING_CONSTRAINT') then
                            continue
                        end
                    end

                    if lConfiguration.Aimbot.ChecksConfiguration.Group   then
                        if lfunctions.CrewCheck(lplayer, Player) then
                            continue
                        end
                    end

                    if lConfiguration.Aimbot.ChecksConfiguration.Friend  then
                        if Player:IsFriendsWithAsync(lplayer.UserId) and lplayer:IsFriendsWithAsync(Player.UserId) then
                            continue
                        end
                    end

                end
                Distance = newdistance
                RenderedPlayer = Player
            end
        end
        ScriptConfiguration.AimBot.Player = RenderedPlayer
    end,
    Callback = function(v)

    end,
})

