	-- выбор темы одним элементом: Section:AddThemeSelector({ Flag = 'Theme' })
	-- тема применяется сразу, сохраняется в конфиг через Flag
	function idx:AddThemeSelector(Config)
		Config = NeverLose:ProcessParams(Config , {
			Name = 'Theme',
			Flag = 'Theme',
			Size = nil,
			Callback = EmptyFunction,
		});

		local names = NeverLose:GetThemeNames();

		table.sort(names , function(a , b)
			if a == 'NeverLose' then
				return true;
			elseif b == 'NeverLose' then
				return false;
			end;

			return a < b;
		end);

		return idx:AddWideDropdown({
			Name = Config.Name,
			Values = names,
			Default = NeverLose.CurrentTheme,
			Search = false,
			MaxVisible = 7,
			Size = Config.Size,
			Flag = Config.Flag,
			Callback = function(name)
				if type(name) == 'string' and NeverLose.Themes[name] then
					NeverLose:SetTheme(name);
				end;

				Config.Callback(name);
			end,
		});
	end;

