			local name = getPriorityName(player);

			row.Team.Text = getCrewText(player);
			row.Priority.Text = name;
			row.Priority.TextColor3 = priorityColor(name);
			row.Button.Visible = matchesSearch(player);
		end;

		local function resort()
			local list = {};

			for player in next , Rows do
				table.insert(list , player);
			end;

			table.sort(list , function(a , b)
				if a == LocalPlayer then return true; end;
				if b == LocalPlayer then return false; end;

				return string.lower(a.Name) < string.lower(b.Name);
			end);

			for i , player in next , list do
				Rows[player].Button.LayoutOrder = i;
			end;
		end;

		local function paintRow(player)
			local row = Rows[player];

			if not row then
				return;
			end;

			NeverLose.PlayAnimate(row.Button , SlowyTween , {
				BackgroundColor3 = (player == Selected) and NeverLose.AccentColor or NeverLose.Theme.Elem,
				BackgroundTransparency = (player == Selected) and 0.75 or 1,
			});
		end;

		refreshCrews = function()
			for player in next , Rows do
				updateRow(player);
			end;

			if Selected then
				updateInfo();
			end;
		end;

		task.spawn(function()
			while Container.Parent do
				task.wait(1);
				refreshCrews();
			end;
		end);

