		----------------------------------------------------------- значения
		local function isMatch(value)
			local d = Config.Default;

			if type(d) == 'table' then
				return (d[value] == true) or (table.find(d , value) ~= nil);
			end;

			return d == value;
		end;

		local function valueText()
			local d = Config.Default;

			if type(d) == 'table' then
				local out = {};

				for _ , item in next , Config.Values do
					if isMatch(item) then
						table.insert(out , tostring(item));
					end;
				end;

				if #out == 0 then
					return Config.Placeholder;
				end;

				return table.concat(out , ', ');
			end;

			if d == nil then
				return Config.Placeholder;
			end;

			return tostring(d);
		end;

		local function updateText()
			FieldLabel.Text = valueText();
		end;

		local function visibleCount()
			local n = 0;

			for _ , it in next , Items do
				if it.Frame.Visible then
					n += 1;
				end;
			end;

			return n;
		end;

		local function relayout()
			if not IsOpen then
				return;
			end;

			local n = visibleCount();
			local rows = math.max(1 , math.min(n , Config.MaxVisible));
			local listH = rows * ItemH;
			local panelH = ListTop + listH + Pad;

			Empty.Visible = (n == 0);
			List.Size = UDim2.new(1 , -Pad * 2 , 0 , (n == 0) and 0 or listH);

			NeverLose.PlayAnimate(Panel , SlowyTween , { Size = UDim2.new(1 , -22 , 0 , panelH) });
			NeverLose.PlayAnimate(Root , SlowyTween , { Size = UDim2.new(1 , 0 , 0 , PanelTop + panelH + S(6)) });
		end;

		local function applyFilter()
			local q = SearchBox and string.lower(SearchBox.Text) or '';

			for _ , it in next , Items do
				it.Frame.Visible = (q == '') or (string.find(string.lower(tostring(it.Value)) , q , 1 , true) ~= nil);
			end;

			relayout();
		end;

		function Lib:Generate()
			for _ , it in next , Items do
				it.Frame:Destroy();
			end;

			for _ , sg in next , Signals do
				sg:Disconnect();
			end;

			table.clear(Items);
			table.clear(Signals);

			for _ , Value in next , Config.Values do
				local ItemFrame = make('Frame' , {
					BackgroundColor3 = NeverLose.Theme.Elem2,
					BackgroundTransparency = 1,
					Size = UDim2.new(1 , 0 , 0 , ItemH),
					ZIndex = Z + 12,
				} , List);
				corner(ItemFrame , S(6));

				local ItemLabel = make('TextLabel' , {
					BackgroundTransparency = 1,
					Position = UDim2.new(0 , S(10) , 0 , 0),
					Size = UDim2.new(1 , -S(36) , 1 , 0),
					ZIndex = Z + 13,
					Font = Enum.Font.GothamMedium,
					Text = tostring(Value),
					TextColor3 = NeverLose.Theme.Text,
					TextSize = FontSize,
					TextTransparency = 0.5,
					TextTruncate = Enum.TextTruncate.AtEnd,
					TextXAlignment = Enum.TextXAlignment.Left,
				} , ItemFrame);

				local Check = make('TextLabel' , {
					AnchorPoint = Vector2.new(1 , 0.5),
					BackgroundTransparency = 1,
					Position = UDim2.new(1 , -S(6) , 0.5 , 0),
					Size = UDim2.new(0 , S(18) , 0 , S(18)),
					ZIndex = Z + 13,
					FontFace = NeverLose.BuiltInBold,
					Text = 'check',
					TextColor3 = NeverLose.AccentColor,
					TextSize = IconSize,
					TextTransparency = 1,
				} , ItemFrame);

				local it = { Frame = ItemFrame , Value = Value };

				function it.mark()
					local on = isMatch(Value);

					NeverLose.PlayAnimate(ItemLabel , SlowyTween , {
						TextTransparency = on and 0.1 or 0.5,
						TextColor3 = on and NeverLose.AccentColor or Color3.fromRGB(255 , 255 , 255),
					});

					NeverLose.PlayAnimate(Check , SlowyTween , { TextTransparency = on and 0.15 or 1 });
				end;

				it.mark();
				table.insert(Items , it);

				table.insert(Signals , ItemFrame.MouseEnter:Connect(function()
					NeverLose.PlayAnimate(ItemFrame , SlowyTween , { BackgroundTransparency = 0.1 });
				end));

				table.insert(Signals , ItemFrame.MouseLeave:Connect(function()
					NeverLose.PlayAnimate(ItemFrame , SlowyTween , { BackgroundTransparency = 1 });
				end));

				local _ , bth = NeverLose:CreateInput(ItemFrame , function()
					if Config.Multi then
						Config.Default[Value] = not Config.Default[Value];
						it.mark();
					else
						Config.Default = Value;

						for _ , o in next , Items do
							o.mark();
						end;

						if Config.CloseOnSelect then
							Lib:Close();
						end;
					end;

					updateText();
					Config.Callback(Config.Default);
				end);

				table.insert(Signals , bth);
			end;

			if IsOpen then
				applyFilter();
			end;
		end;

		function Lib:Open()
			if IsOpen then
				return;
			end;

			IsOpen = true;
			Panel.Visible = true;
			Chevron.Rotation = 180;

			if SearchBox then
				SearchBox.Text = '';
			end;

			for _ , it in next , Items do
				it.mark();
			end;

			applyFilter();
		end;

		function Lib:Close()
			if not IsOpen then
				return;
			end;

			IsOpen = false;
			Panel.Visible = false;
			Panel.Size = UDim2.new(1 , -22 , 0 , 0);
			Chevron.Rotation = 0;

			NeverLose.PlayAnimate(Root , SlowyTween , { Size = UDim2.new(1 , 0 , 0 , ClosedH) });
		end;

		function Lib:Toggle()
			if IsOpen then
				Lib:Close();
			else
				Lib:Open();
			end;
		end;

		function Lib:GetValue()
			return Config.Default;
		end;

		function Lib:SetValue(v)
			v = NeverLose.ProcessDropdown(v);

			if Config.Multi and type(v) ~= 'table' then
				v = (v ~= nil) and { [v] = true } or {};
			end;

			Config.Default = v;

			updateText();

			for _ , it in next , Items do
				it.mark();
			end;

			Config.Callback(Config.Default);
		end;

		function Lib:SetValues(list)
			Config.Values = list;
			Lib:Generate();
			updateText();
		end;

		function Lib:SetName(n)
			Config.Name = n;
			NameLabel.Text = n;
		end;

		function Lib:Destroy()
			for _ , sg in next , Signals do
				sg:Disconnect();
			end;

			Root:Destroy();
		end;

		NeverLose:CreateInput(Field , function()
			Lib:Toggle();
		end);

		if SearchBox then
			NeverLose:AddSignal(SearchBox:GetPropertyChangedSignal('Text'):Connect(applyFilter));
		end;

		Root.Visible = Signel:GetValue() and true or false;

		Signel:Connect(function(v)
			Root.Visible = v and true or false;

			if not v then
				Lib:Close();
			end;
		end);

		Lib.Root = Root;

		Lib:Generate();
		updateText();

		if Config.Flag then
			NeverLose.Flags[Config.Flag] = Lib;
		end;

		return Lib;
	end;

	idx.AddTestDropdown = idx.AddWideDropdown; -- короткое имя для теста

	-- ШИРОКИЙ slider: подпись слева сверху, значение справа сверху, ползунок на всю ширину секции
	-- Параметры и значения те же, что у AddSlider (Min, Max, Default, Rounding, Type, Nums, Flag, Callback)
	function idx:AddWideSlider(Config)
		Config = NeverLose:ProcessParams(Config , {
			Name = 'Slider',
			Default = 50,
			Min = 0,
			Max = 10,
			Type = '',          -- суффикс значения: '%', 'px', ...
			Rounding = 0,
			Nums = {},          -- { [значение] = 'текст' }
			Flag = nil,
			Callback = EmptyFunction,
		});

		Config.Default = math.clamp(Config.Default , Config.Min , Config.Max);

		local Z = LayerIndex;
		local Lib = {};
		local IsHold = false;

		local function span()
			return math.max(Config.Max - Config.Min , 1e-9);
		end;

		local function scale()
			return (Config.Default - Config.Min) / span();
		end;

		local function make(class , props , parent)
			local obj = Instance.new(class);

			obj.Name = NeverLose.RandomString();

			if obj:IsA('GuiObject') then
				obj.BorderSizePixel = 0;
				obj.BorderColor3 = Color3.fromRGB(0 , 0 , 0);
			end;

			for k , v in next , props do
				obj[k] = v;
			end;

			obj.Parent = parent;

			return obj;
		end;

		local FullNumSize = NeverLose.GetTextSize(string.rep('0' , (Config.Rounding + #tostring(Config.Max)) + 1) .. tostring(Config.Type) , 10 , Enum.Font.GothamMedium , Vector2.new(math.huge , math.huge));
		local ValueW = FullNumSize.X + 12;

		local Root = make('Frame' , {
			BackgroundTransparency = 1,
			Size = UDim2.new(1 , 0 , 0 , 50),
			ZIndex = Z + 8,
		} , Frame);

		NeverLose:AddQuery(Root , Config.Name);

		local NameLabel = make('TextLabel' , {
			BackgroundTransparency = 1,
			Position = UDim2.new(0 , 11 , 0 , 5),
			Size = UDim2.new(1 , -(ValueW + 30) , 0 , 16),
			ZIndex = Z + 9,
			Font = Enum.Font.GothamMedium,
			Text = Config.Name,
			TextColor3 = NeverLose.Theme.Text,
			TextSize = 13,
			TextTransparency = 0.35,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Left,
		} , Root);

		make('Frame' , {
			AnchorPoint = Vector2.new(0.5 , 1),
			BackgroundColor3 = NeverLose.Theme.Stroke,
			BackgroundTransparency = 0.65,
			Position = UDim2.new(0.5 , 0 , 1 , 0),
			Size = UDim2.new(1 , -20 , 0 , 1),
			ZIndex = Z + 11,
		} , Root);

		----------------------------------------------------------- значение (можно нажать и ввести число)
		local ValueFrame = make('Frame' , {
			AnchorPoint = Vector2.new(1 , 0),
			BackgroundColor3 = NeverLose.Theme.Field,
			Position = UDim2.new(1 , -11 , 0 , 4),
			Size = UDim2.new(0 , ValueW , 0 , 18),
			ZIndex = Z + 10,
		} , Root);
		make('UICorner' , { CornerRadius = UDim.new(0 , 4) } , ValueFrame);
		make('UIStroke' , { Color = NeverLose.Theme.Stroke , Transparency = 0.65 } , ValueFrame);

		local ValueBox = make('TextBox' , {
			BackgroundTransparency = 1,
			Size = UDim2.new(1 , 0 , 1 , 0),
			ZIndex = Z + 11,
			ClearTextOnFocus = false,
			Font = Enum.Font.GothamMedium,
			Text = '',
			TextColor3 = NeverLose.Theme.Text,
			TextSize = 10,
			TextTransparency = 0.35,
		} , ValueFrame);

		----------------------------------------------------------- ползунок
		local SlideMain = make('Frame' , {
			BackgroundTransparency = 1,
			Position = UDim2.new(0 , 11 , 0 , 26),
			Size = UDim2.new(1 , -22 , 0 , 18),
			ZIndex = Z + 9,
		} , Root);

		local SlideFrame = make('Frame' , {
			AnchorPoint = Vector2.new(0 , 0.5),
			BackgroundColor3 = NeverLose.Theme.Track,
			Position = UDim2.new(0 , 0 , 0.5 , 0),
			Size = UDim2.new(1 , 0 , 0 , 5),
			ZIndex = Z + 10,
		} , SlideMain);
		make('UICorner' , { CornerRadius = UDim.new(1 , 0) } , SlideFrame);

		local SlideMoving = make('Frame' , {
			BackgroundColor3 = NeverLose.AccentColor,
			Size = UDim2.new(scale() , 0 , 1 , 0),
			ZIndex = Z + 11,
		} , SlideFrame);
		make('UICorner' , { CornerRadius = UDim.new(1 , 0) } , SlideMoving);

		local Knob = make('Frame' , {
			AnchorPoint = Vector2.new(1 , 0.5),
			BackgroundColor3 = Color3.fromRGB(255 , 255 , 255),
			Position = UDim2.new(1 , 5 , 0.5 , 0),
			Size = UDim2.new(0 , 10 , 0 , 10),
			ZIndex = Z + 12,
		} , SlideMoving);
		make('UICorner' , { CornerRadius = UDim.new(1 , 0) } , Knob);

		local function loadText()
			if Config.Nums[Config.Default] then
				ValueBox.Text = tostring(Config.Nums[Config.Default]);
			else
				ValueBox.Text = tostring(Config.Default) .. tostring(Config.Type);
			end;
		end;

		local function grow(on)
			NeverLose.PlayAnimate(Knob , SlowyTween , { Size = on and UDim2.new(0 , 13 , 0 , 13) or UDim2.new(0 , 10 , 0 , 10) });
		end;

		local function apply(value , fire)
			Config.Default = value;

			TweenService:Create(SlideMoving , ManualTween , { Size = UDim2.new(scale() , 0 , 1 , 0) }):Play();

			loadText();

			if fire then
				Config.Callback(Config.Default);
			end;
		end;

		local function update(Input)
			local sc = math.clamp((Input.Position.X - SlideMain.AbsolutePosition.X) / math.max(SlideMain.AbsoluteSize.X , 1) , 0 , 1);
			local value = NeverLose.Rounding((span() * sc) + Config.Min , Config.Rounding);

			apply(value , true);
		end;

		NeverLose:AddSignal(SlideMain.InputBegan:Connect(function(Input)
			if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
				IsHold = true;
				grow(true);
				update(Input);
			end;
		end));

		NeverLose:AddSignal(UserInputService.InputEnded:Connect(function(Input)
			if IsHold and (Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch) then
				IsHold = false;
				grow(false);
			end;
		end));

		NeverLose:AddSignal(UserInputService.InputChanged:Connect(function(Input)
			if IsHold and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
				if UserInputService.TouchEnabled and not NeverLose:IsMouseOverFrame(SlideMain) then
					IsHold = false; -- палец ушёл с ползунка: отдаём жест прокрутке
					grow(false);
				else
					update(Input);
				end;
			end;
		end));

		NeverLose:AddSignal(ValueBox.FocusLost:Connect(function()
			local out = NeverLose:ParseInput(ValueBox.Text , true);

			if out then
				apply(NeverLose.Rounding(math.clamp(out , Config.Min , Config.Max) , Config.Rounding) , true);
			else
				loadText();
			end;
		end));

		function Lib:GetValue()
			return Config.Default;
		end;

		function Lib:SetValue(v)
			if type(v) ~= 'number' then
				return;
			end;

			apply(math.clamp(v , Config.Min , Config.Max) , true);
		end;

		function Lib:SetName(n)
			Config.Name = n;
			NameLabel.Text = n;
		end;

		function Lib:Destroy()
			Root:Destroy();
		end;

		Root.Visible = Signel:GetValue() and true or false;

		Signel:Connect(function(v)
			Root.Visible = v and true or false;
		end);

		Lib.Root = Root;

		loadText();

		if Config.Flag then
			NeverLose.Flags[Config.Flag] = Lib;
		end;

		return Lib;
	end;

	-- ШИРОКИЙ SQUIRCLE slider: подпись слева сверху, значение справа сверху, ниже широкая полоса 26px со скруглёнными углами (в стиле squircle-тогла)
	-- Параметры и значения те же, что у AddSlider (Min, Max, Default, Rounding, Type, Nums, Flag, Callback)
	function idx:AddWideSquircleSlider(Config)
		Config = NeverLose:ProcessParams(Config , {
			Name = 'Slider',
			Mode = 'Stripe',      -- 'Stripe' - с белой полоской на конце заливки; 'Plain' - без полоски
			Default = 50,
			Min = 0,
			Max = 10,
			Type = '',          -- суффикс значения: '%', 'px', ...
			Rounding = 0,
			Nums = {},          -- { [значение] = 'текст' }
			Flag = nil,
			Size = nil,         -- масштаб ВСЕГО слайдера: nil/1 = как сейчас, 0.85 = меньше, или 'Small' / 'Medium' / 'Default' / 'Large'
			Callback = EmptyFunction,
		});

		Config.Default = math.clamp(Config.Default , Config.Min , Config.Max);

		local Z = LayerIndex;
		local Lib = {};
		local IsHold = false;

		-- масштаб всего элемента (подпись, значение, полоса, ручка, отступы); без Size всё как раньше
		local UIScale = 1;

		if type(Config.Size) == 'number' then
			UIScale = Config.Size;
		elseif type(Config.Size) == 'string' then
			UIScale = ({ small = 0.8 , medium = 0.9 , default = 1 , large = 1.1 })[string.lower(Config.Size)] or 1;
		end;

		UIScale = math.clamp(UIScale , 0.6 , 1.4);

		local function S(n)
			return math.floor(n * UIScale + 0.5);
		end;

		-- размер текста не масштабируется: Size меняет только геометрию
		local NameSize = 13;
		local ValText = 10;
		local ValH = S(18);
		local BarY = S(26);
		local BarH = S(26);
		local RootH = BarY + BarH + S(6);

		local function span()
			return math.max(Config.Max - Config.Min , 1e-9);
		end;

		local function scale()
			return (Config.Default - Config.Min) / span();
		end;

		local function make(class , props , parent)
			local obj = Instance.new(class);

			obj.Name = NeverLose.RandomString();

			if obj:IsA('GuiObject') then
				obj.BorderSizePixel = 0;
				obj.BorderColor3 = Color3.fromRGB(0 , 0 , 0);
			end;

			for k , v in next , props do
				obj[k] = v;
			end;

			obj.Parent = parent;

			return obj;
		end;

		local FullNumSize = NeverLose.GetTextSize(string.rep('0' , (Config.Rounding + #tostring(Config.Max)) + 1) .. tostring(Config.Type) , ValText , Enum.Font.GothamMedium , Vector2.new(math.huge , math.huge));
		local ValueW = FullNumSize.X + S(12);

		local Root = make('Frame' , {
			BackgroundTransparency = 1,
			Size = UDim2.new(1 , 0 , 0 , RootH),
			ZIndex = Z + 8,
		} , Frame);

		NeverLose:AddQuery(Root , Config.Name);

		local NameLabel = make('TextLabel' , {
			BackgroundTransparency = 1,
			Position = UDim2.new(0 , 11 , 0 , S(5)),
			Size = UDim2.new(1 , -(ValueW + 30) , 0 , S(16)),
			ZIndex = Z + 9,
			Font = Enum.Font.GothamMedium,
			Text = Config.Name,
			TextColor3 = NeverLose.Theme.Text,
			TextSize = NameSize,
			TextTransparency = 0.35,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Left,
		} , Root);

		local Divider = make('Frame' , {
			AnchorPoint = Vector2.new(0.5 , 1),
			BackgroundColor3 = NeverLose.Theme.Stroke,
			BackgroundTransparency = 0.65,
			Position = UDim2.new(0.5 , 0 , 1 , 0),
			Size = UDim2.new(1 , -20 , 0 , 1),
			ZIndex = Z + 11,
		} , Root);

		----------------------------------------------------------- значение (можно нажать и ввести число)
		local ValueFrame = make('Frame' , {
			AnchorPoint = Vector2.new(1 , 0),
			BackgroundColor3 = NeverLose.Theme.Field,
			Position = UDim2.new(1 , -11 , 0 , S(4)),
			Size = UDim2.new(0 , ValueW , 0 , ValH),
			ZIndex = Z + 10,
		} , Root);
		make('UICorner' , { CornerRadius = UDim.new(0 , S(4)) } , ValueFrame);
		local ValueStroke = make('UIStroke' , { Color = NeverLose.Theme.Stroke , Transparency = 0.65 } , ValueFrame);

		local ValueBox = make('TextBox' , {
			BackgroundTransparency = 1,
			Size = UDim2.new(1 , 0 , 1 , 0),
			ZIndex = Z + 11,
			ClearTextOnFocus = false,
			Font = Enum.Font.GothamMedium,
			Text = '',
			TextColor3 = NeverLose.Theme.Text,
			TextSize = ValText,
			TextTransparency = 0.35,
		} , ValueFrame);

		----------------------------------------------------------- ползунок (squircle bar)
		local SlideMain = make('Frame' , {
			BackgroundColor3 = NeverLose.Theme.Deep,
			ClipsDescendants = true,
			Position = UDim2.new(0 , 11 , 0 , BarY),
			Size = UDim2.new(1 , -22 , 0 , BarH),
			ZIndex = Z + 9,
		} , Root);
		make('UICorner' , { CornerRadius = UDim.new(0 , S(9)) } , SlideMain);
		local SlideStroke = make('UIStroke' , { Color = NeverLose.Theme.Stroke , Transparency = 0.1 } , SlideMain);

		local SlideMoving = make('Frame' , {
			BackgroundColor3 = NeverLose.AccentColor,
			Size = UDim2.new(scale() , 0 , 1 , 0),
			ZIndex = Z + 10,
		} , SlideMain);
		make('UICorner' , { CornerRadius = UDim.new(0 , S(8)) } , SlideMoving);
		make('UISizeConstraint' , { MinSize = Vector2.new(S(14) , 0) } , SlideMoving);

		-- режим Plain: градиент акцента со светлым верхним краем, скруглён с обоих концов, без полоски
		local PlainGrad = nil;

		local function PlainSeq(c)
			return ColorSequence.new({
				ColorSequenceKeypoint.new(0 , c:Lerp(Color3.new(1 , 1 , 1) , 0.25)),
				ColorSequenceKeypoint.new(0.45 , c),
				ColorSequenceKeypoint.new(1 , c:Lerp(Color3.new(0 , 0 , 0) , 0.2)),
			});
		end;

		if Config.Mode == 'Plain' then
			SlideMoving.BackgroundColor3 = Color3.fromRGB(255 , 255 , 255);

			PlainGrad = make('UIGradient' , {
				Color = PlainSeq(NeverLose.Theme.Accent),
				Rotation = 90,
			} , SlideMoving);

			make('Frame' , {
				BackgroundColor3 = Color3.fromRGB(255 , 255 , 255),
				BackgroundTransparency = 0.72,
				Position = UDim2.new(0 , S(4) , 0 , 1),
				Size = UDim2.new(1 , -S(8) , 0 , 1),
				ZIndex = Z + 11,
			} , SlideMoving);
		end;

		-- белая ручка на конце заливки
		local Knob = make('Frame' , {
			AnchorPoint = Vector2.new(1 , 0.5),
			BackgroundColor3 = Color3.fromRGB(255 , 255 , 255),
			BackgroundTransparency = 0.15,
			Position = UDim2.new(1 , -S(5) , 0.5 , 0),
			Size = UDim2.new(0 , math.max(S(3) , 2) , 1 , -S(14)),
			ZIndex = Z + 11,
		} , SlideMoving);
		make('UICorner' , { CornerRadius = UDim.new(0 , 2) } , Knob);

		Knob.Visible = (Config.Mode ~= 'Plain');

		local function loadText()
			if Config.Nums[Config.Default] then
				ValueBox.Text = tostring(Config.Nums[Config.Default]);
			else
				ValueBox.Text = tostring(Config.Default) .. tostring(Config.Type);
			end;
		end;

		local function grow(on)
			NeverLose.PlayAnimate(Knob , SlowyTween , { Size = on and UDim2.new(0 , math.max(S(5) , 3) , 1 , -S(10)) or UDim2.new(0 , math.max(S(3) , 2) , 1 , -S(14)) });
		end;

		local function apply(value , fire)
			Config.Default = value;

			TweenService:Create(SlideMoving , ManualTween , { Size = UDim2.new(scale() , 0 , 1 , 0) }):Play();

			loadText();

			if fire then
				Config.Callback(Config.Default);
			end;
		end;

		local function update(Input)
			local sc = math.clamp((Input.Position.X - SlideMain.AbsolutePosition.X) / math.max(SlideMain.AbsoluteSize.X , 1) , 0 , 1);
			local value = NeverLose.Rounding((span() * sc) + Config.Min , Config.Rounding);

			apply(value , true);
		end;

		NeverLose:AddSignal(SlideMain.InputBegan:Connect(function(Input)
			if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
				IsHold = true;
				grow(true);
				update(Input);
			end;
		end));

		NeverLose:AddSignal(UserInputService.InputEnded:Connect(function(Input)
			if IsHold and (Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch) then
				IsHold = false;
				grow(false);
			end;
		end));

		NeverLose:AddSignal(UserInputService.InputChanged:Connect(function(Input)
			if IsHold and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
				if UserInputService.TouchEnabled and not NeverLose:IsMouseOverFrame(SlideMain) then
					IsHold = false; -- палец ушёл с ползунка: отдаём жест прокрутке
					grow(false);
				else
					update(Input);
				end;
			end;
		end));

		NeverLose:AddSignal(ValueBox.FocusLost:Connect(function()
			local out = NeverLose:ParseInput(ValueBox.Text , true);

			if out then
				apply(NeverLose.Rounding(math.clamp(out , Config.Min , Config.Max) , Config.Rounding) , true);
			else
				loadText();
			end;
		end));

		-- перекраска при смене темы: напрямую, без подбора по цвету
		NeverLose.ThemeListeners[#NeverLose.ThemeListeners + 1] = function()
			if not Root.Parent then
				return false;
			end;

			NameLabel.TextColor3 = NeverLose.Theme.Text;
			Divider.BackgroundColor3 = NeverLose.Theme.Stroke;
			ValueFrame.BackgroundColor3 = NeverLose.Theme.Field;
			ValueStroke.Color = NeverLose.Theme.Stroke;
			ValueBox.TextColor3 = NeverLose.Theme.Text;
			SlideMain.BackgroundColor3 = NeverLose.Theme.Deep;
			SlideStroke.Color = NeverLose.Theme.Stroke;
			if Config.Mode == 'Plain' then
				if PlainGrad then PlainGrad.Color = PlainSeq(NeverLose.Theme.Accent) end;
			else
				SlideMoving.BackgroundColor3 = NeverLose.Theme.Accent;
			end;
		end;

		function Lib:GetValue()
			return Config.Default;
		end;

		function Lib:SetValue(v)
			if type(v) ~= 'number' then
				return;
			end;

			apply(math.clamp(v , Config.Min , Config.Max) , true);
		end;

		function Lib:SetName(n)
			Config.Name = n;
			NameLabel.Text = n;
		end;

		function Lib:Destroy()
			Root:Destroy();
		end;

		Root.Visible = Signel:GetValue() and true or false;

		Signel:Connect(function(v)
			Root.Visible = v and true or false;
		end);

		Lib.Root = Root;

		loadText();

		if Config.Flag then
			NeverLose.Flags[Config.Flag] = Lib;
		end;

		return Lib;
	end;

