vlxtable.GunMacroEnabled = vlxtable.GunMacroLocal:AddLabel('Enabled')
vlxtable.GunMacroEnabledToggle = vlxtable.GunMacroEnabled:AddToggle({
    Default = false,
    Flag = "GunMacroEnabled",
    Callback = function(val)
        if ismobuser then
            lConfiguration.GunMacro.Enabled = val
            return
        end

        if not val then
            if Connections['GunMacroInputBegan'] then
                Connections['GunMacroInputBegan']:Disconnect()
                Connections['GunMacroInputBegan'] = nil
            end
        end
        if val then
            Connections['GunMacroInputBegan'] = uis.InputBegan:Connect(LPH_NO_VIRTUALIZE(function(input, gpe)
                if gpe then return end
                if lConfiguration.GunMacro.Keybind == 'NUL' then
                    return
                end

                if input.KeyCode == Enum.KeyCode[lConfiguration.GunMacro.Keybind] then
                    lfunctions.GunMacro()
                end
            end))
        end
    end
})

