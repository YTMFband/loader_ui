	-- ===== оформление =====
	local function paint()
		Root.BackgroundColor3 = role('Card' , Color3.fromRGB(20 , 22 , 27));
		RootStroke.Color = role('Stroke' , Color3.fromRGB(45 , 48 , 58));
		AvatarStroke.Color = RootStroke.Color;
		Avatar.BackgroundColor3 = role('Deep' , Color3.fromRGB(10 , 13 , 21));
		Track.BackgroundColor3 = WHITE;
		ArTrack.BackgroundColor3 = WHITE;
		ArFill.BackgroundColor3 = role('Accent' , Color3.fromRGB(78 , 127 , 252));
		ArmorValue.TextColor3 = role('Accent' , WHITE);
		ArmorLabel.TextColor3 = role('TextDim' , WHITE);
		Title.TextColor3 = role('Text' , WHITE);
		NameLabel.TextColor3 = role('Text' , WHITE);
		HpMax.TextColor3 = role('Text' , WHITE);
		TeamLabel.TextColor3 = role('TextDim' , WHITE);
		DistLabel.TextColor3 = role('Accent' , WHITE);
	end;

	-- здоровье зелёное, при 30% и ниже красное
	local function colorHealth()
		local low = LastRatio <= 0.3;
		local c = low and RED or GREEN;
		local c2 = low and Color3.fromRGB(224 , 69 , 69) or Color3.fromRGB(34 , 196 , 136);

		FillGrad.Color = ColorSequence.new(c2 , c);
		HpNum.TextColor3 = c;
	end;

	local function setHealth(hum)
		local max = math.max(hum.MaxHealth , 1);
		local hp = math.clamp(hum.Health , 0 , max);
		local ratio = hp / max;
		local dropped = ratio < LastRatio;

		HpNum.Text = tostring(math.ceil(hp));
		HpMax.Text = '/ ' .. tostring(math.floor(max));
		LastRatio = ratio;
		colorHealth();

		TweenService:Create(Fill , TweenInfo.new(0.12) , { Size = UDim2.fromScale(ratio , 1) }):Play();

		if dropped then
			local my = Token;

			task.delay(0.35 , function()
				if my == Token then
					TweenService:Create(Ghost , TweenInfo.new(0.4) , { Size = UDim2.fromScale(ratio , 1) }):Play();
				end;
			end);
		else
			Ghost.Size = UDim2.fromScale(ratio , 1);
		end;
	end;

	-- ===== броня =====
	-- значение брони из character.BodyEffects.Armor; нет папки или значения - 0
	setArmor = function(v)
		local n = tonumber(v) or 0;

		ArmorVal = math.clamp(math.floor(n + 0.5) , 0 , ArmorMax);
		ArmorValue.Text = tostring(ArmorVal) .. ' / ' .. tostring(ArmorMax);

		TweenService:Create(ArFill , TweenInfo.new(0.2) , { Size = UDim2.fromScale(ArmorVal / ArmorMax , 1) }):Play();
	end;

	local function clearArmorConns()
		for _ , c in next , ArmorConns do
			c:Disconnect();
		end;

		table.clear(ArmorConns);
	end;

	bindArmor = function(char)
		clearArmorConns();

		if not char then
			setArmor(0);
			return;
		end;

		local body = char:FindFirstChild(Config.BodyFolder);
		local obj = body and body:FindFirstChild(Config.ArmorName);

		if obj and obj:IsA('ValueBase') then
			setArmor(obj.Value);

			table.insert(ArmorConns , NeverLose:AddSignal(obj.Changed:Connect(function(v)
				setArmor(v);
			end)));
		else
			setArmor(0);
		end;

		-- появилась или пропала папка / значение: перепривязываемся
		table.insert(ArmorConns , NeverLose:AddSignal(char.ChildAdded:Connect(function(c)
			if c.Name == Config.BodyFolder then
				bindArmor(char);
			end;
		end)));

		table.insert(ArmorConns , NeverLose:AddSignal(char.ChildRemoved:Connect(function(c)
			if c.Name == Config.BodyFolder then
				bindArmor(char);
			end;
		end)));

		if body then
			table.insert(ArmorConns , NeverLose:AddSignal(body.ChildAdded:Connect(function(c)
				if c.Name == Config.ArmorName then
					bindArmor(char);
				end;
			end)));

			table.insert(ArmorConns , NeverLose:AddSignal(body.ChildRemoved:Connect(function(c)
				if c.Name == Config.ArmorName then
					bindArmor(char);
				end;
			end)));
		end;
	end;

	-- ===== оружие =====
	local WeaponConns = {};

	local function clearWeaponConns()
		for _ , c in next , WeaponConns do
			c:Disconnect();
		end;

		table.clear(WeaponConns);
	end;

	setWeapon = function(tool)
		if not tool then
			WeaponName.Text = 'No tool';
			WeaponSub.Text = 'Hands empty';
			AmmoRow.Visible = false;
			return;
		end;

		WeaponName.Text = tool.Name;

		local ammo = tool:FindFirstChild('Ammo');

		-- нет Ammo - ближнее оружие, патроны не показываем
		if not (ammo and ammo:IsA('ValueBase') and tonumber(ammo.Value)) then
			WeaponSub.Text = 'Melee';
			AmmoRow.Visible = false;
			return;
		end;

		local a = math.floor(tonumber(ammo.Value));
		local maxAmmo = tool:FindFirstChild('MaxAmmo');
		local mx = maxAmmo and maxAmmo:IsA('ValueBase') and tonumber(maxAmmo.Value) or nil;

		WeaponSub.Text = 'Equipped';
		WeaponAmmo.Text = tostring(a);
		WeaponAmmo.TextColor3 = (a <= 0) and RED or role('Text' , WHITE);
		WeaponMax.Text = mx and ('/ ' .. tostring(math.floor(mx))) or '';
		AmmoRow.Visible = true;
	end;

	bindWeapon = function(char)
		clearWeaponConns();

		local tool = char and char:FindFirstChildOfClass('Tool') or nil;

		setWeapon(tool);

		if tool then
			for _ , n in next , { 'Ammo' , 'MaxAmmo' } do
				local v = tool:FindFirstChild(n);

				if v and v:IsA('ValueBase') then
					table.insert(WeaponConns , NeverLose:AddSignal(v.Changed:Connect(function()
						setWeapon(tool);
					end)));
				end;
			end;

			table.insert(WeaponConns , NeverLose:AddSignal(tool.ChildAdded:Connect(function()
				setWeapon(tool);
			end)));

			table.insert(WeaponConns , NeverLose:AddSignal(tool.ChildRemoved:Connect(function()
				setWeapon(tool);
			end)));
		end;

		-- сменили инструмент в руках
		if char then
			table.insert(WeaponConns , NeverLose:AddSignal(char.ChildAdded:Connect(function(c)
				if c:IsA('Tool') then
					bindWeapon(char);
				end;
			end)));

			table.insert(WeaponConns , NeverLose:AddSignal(char.ChildRemoved:Connect(function(c)
				if c:IsA('Tool') then
					bindWeapon(char);
				end;
			end)));
		end;
	end;

	local function showEmpty()
		NameLabel.Text = 'No target';
		HpNum.Text = '-';
		HpMax.Text = '';
		TeamLabel.Text = 'No crew';
		DistLabel.Text = '-';
		Avatar.Image = '';
		LastRatio = 1;
		Fill.Size = UDim2.fromScale(0 , 1);
		Ghost.Size = UDim2.fromScale(0 , 1);
		setArmor(0);
		setWeapon(nil);
		colorHealth();
	end;

	-- ===== группа (crew) =====
	-- ID: player.DataFolder.Information.Crew.Value (пусто или 0 - группы нет)
	-- Название: GroupService:GetGroupInfoAsync(ID). Кэш, при ошибке повтор через 10 с.
	local GroupService = game:GetService('GroupService');
	local CrewNames = {};
	local CrewPending = {};
	local CrewFailedAt = {};

	local function getCrewId(player)
		local data = player and player:FindFirstChild('DataFolder');
		local info = data and data:FindFirstChild('Information');
		local crew = info and info:FindFirstChild('Crew');

		if not crew or not crew:IsA('ValueBase') then
			return nil;
		end;

		local id = tonumber(crew.Value);

		if id and id > 0 then
			return math.floor(id);
		end;

		return nil;
	end;

	local function setCrewLabel(id)
		if not id then
			TeamLabel.Text = 'No crew';
			return;
		end;

		if CrewNames[id] then
			TeamLabel.Text = CrewNames[id];
			return;
		end;

		if CrewFailedAt[id] and os.clock() - CrewFailedAt[id] < 10 then
			TeamLabel.Text = 'Group #' .. tostring(id);
			return;
		end;

		TeamLabel.Text = 'Loading...';

		if CrewPending[id] then
			return;
		end;

		CrewPending[id] = true;

		task.spawn(function()
			local ok , info = pcall(GroupService.GetGroupInfoAsync , GroupService , id);

			CrewPending[id] = nil;

			if ok and info and info.Name then
				CrewNames[id] = info.Name;
				CrewFailedAt[id] = nil;
			else
				CrewFailedAt[id] = os.clock();
			end;

			-- обновляем, только если ещё та же группа у цели
			if Target and getCrewId(Target) == id then
				setCrewLabel(id);
			end;
		end);
	end;

	local function distanceTo(player)
		local mine = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild('HumanoidRootPart');
		local theirs = player.Character and player.Character:FindFirstChild('HumanoidRootPart');

		if mine and theirs then
			return (mine.Position - theirs.Position).Magnitude;
		end;

		return nil;
	end;

	local function setAvatar(player)
		local img = Thumbs[player.UserId];

		if img then
			Avatar.Image = img;
			return;
		end;

		Avatar.Image = '';

		task.spawn(function()
			local ok , image = pcall(Players.GetUserThumbnailAsync , Players , player.UserId , Enum.ThumbnailType.HeadShot , Enum.ThumbnailSize.Size150x150);

			if ok and image then
				Thumbs[player.UserId] = image;

				if Target == player then
					Avatar.Image = image;
				end;
			end;
		end);
	end;

	local function clearHumConns()
		for _ , c in next , HumConns do
			c:Disconnect();
		end;

		table.clear(HumConns);
	end;

	local function bindHumanoid()
		clearHumConns();

		if not Target then
			return;
		end;

		local hum = Target.Character and Target.Character:FindFirstChildOfClass('Humanoid');

		if hum then
			LastRatio = hum.Health / math.max(hum.MaxHealth , 1);
			setHealth(hum);

			table.insert(HumConns , NeverLose:AddSignal(hum.HealthChanged:Connect(function()
				setHealth(hum);
			end)));

			table.insert(HumConns , NeverLose:AddSignal(hum:GetPropertyChangedSignal('MaxHealth'):Connect(function()
				setHealth(hum);
			end)));
		else
			HpNum.Text = '-';
			HpMax.Text = '';
			Fill.Size = UDim2.fromScale(0 , 1);
			Ghost.Size = UDim2.fromScale(0 , 1);
		end;
	end;

	-- после возрождения цели подключаемся заново (здоровье и броня)
	local function onCharacter(char)
		if not Target then
			return;
		end;

		local my = Token;

		bindArmor(char);
		bindWeapon(char);

		task.spawn(function()
			local hum = char:WaitForChild('Humanoid' , 5);

			if my == Token and hum then
				bindHumanoid();
			end;
		end);
	end;

	-- ===== API =====
	function Card:SetTarget(player)
		if typeof(player) ~= 'Instance' or not player:IsA('Player') or player == LocalPlayer then
			player = nil;
		end;

		if player == Target then
			return;
		end;

		for _ , c in next , TargetConns do
			c:Disconnect();
		end;

		table.clear(TargetConns);
		clearHumConns();
		clearArmorConns();
		clearWeaponConns();

		Target = player;
		Token += 1;

		local my = Token;

		if not Target then
			showEmpty();
			task.spawn(Config.Callback , nil);
			return;
		end;

		NameLabel.Text = Target.DisplayName;
		setCrewLabel(getCrewId(Target));
		DistLabel.Text = '-';
		setAvatar(Target);

		table.insert(TargetConns , Target.CharacterAdded:Connect(onCharacter));

		if Target.Character then
			onCharacter(Target.Character);
		else
			bindArmor(nil);
			bindWeapon(nil);
			bindHumanoid();
		end;

		-- дистанция обновляется 5 раз в секунду, пока цель выбрана
		task.spawn(function()
			while my == Token and Target do
				local d = distanceTo(Target);
				setCrewLabel(getCrewId(Target));

				DistLabel.Text = d and string.format('%.1f m' , d) or '-';
				task.wait(0.2);
			end;
		end);

		task.spawn(Config.Callback , Target);
	end;

	function Card:ClearTarget()
		Card:SetTarget(nil);
	end;

	function Card:GetTarget()
		return Target;
	end;

	function Card:SetName(n)
		Title.Text = n;
	end;

	function Card:SetVisible(v)
		Root.Visible = v and true or false;
	end;

	function Card:Toggle()
		Root.Visible = not Root.Visible;
	end;

	function Card:Destroy()
		Token += 1;
		Target = nil;

		for _ , c in next , TargetConns do
			c:Disconnect();
		end;

		table.clear(TargetConns);
		clearHumConns();
		clearArmorConns();
		clearWeaponConns();
		Root:Destroy();
	end;

	Card.Root = Root;

	paint();
	showEmpty();

	-- смена темы перекрашивает карточку; после Destroy слушатель сам удаляется
	table.insert(NeverLose.ThemeListeners , function()
		if not Root.Parent then
			return false;
		end;

		paint();
		colorHealth();
	end);

	-- если выбранный игрок вышел, карточка сбрасывается
	NeverLose:AddSignal(Players.PlayerRemoving:Connect(function(p)
		if p == Target then
			Card:SetTarget(nil);
		end;
	end));

	return Card;
end;

-- Редактор темы: dropdown Base theme + колорпикер на каждую роль.
-- Смена базовой темы ставит все пикеры в значения пресета и применяет тему одним SetTheme.
-- Смена одного пикера меняет только его роль. Ничего вручную привязывать не нужно.
function NeverLose:AddThemeEditor(Section, Config)
	Config = NeverLose:ProcessParams(Config or {}, {
		Name = 'Base theme',
		Default = nil,
		FlagPrefix = 'Theme_',
		OnBase = EmptyFunction,   -- (themeName)
		OnRole = EmptyFunction,   -- (roleName, color)
	});

	local ROLES = { 'Main' , 'Card' , 'Elem' , 'Elem2' , 'Hover' , 'Field' , 'Deep' , 'Deep2' , 'Track' , 'Stroke' , 'Text' , 'Icon' , 'TextDim' , 'TextMute' , 'Accent' };

	local syncing = false;  -- true, пока мы сами выставляем пикеры (их колбеки не должны запускать SetTheme)
	local pickers = {};

	Section:AddWideDropdown({
		Name = Config.Name,
		Values = NeverLose:GetThemeNames(),
		Default = Config.Default or NeverLose.CurrentTheme,
		Search = false,
		MaxVisible = 7,
		Flag = Config.FlagPrefix .. 'Base',
		Callback = function(name)
			if type(name) ~= 'string' or not NeverLose.Themes[name] then
				return;
			end;

			syncing = true;
			NeverLose:SetTheme(name);

			for _ , role in next , ROLES do
				local p = pickers[role];

				if p and NeverLose.Theme[role] then
					p:SetValue(NeverLose.Theme[role]);
				end;
			end;

			syncing = false;

			Config.OnBase(name);
		end,
	});

	for _ , role in next , ROLES do
		pickers[role] = Section:AddLabel(role):AddColorPicker({
			Default = NeverLose.Theme[role] or Color3.fromRGB(255 , 255 , 255),
			Flag = Config.FlagPrefix .. role,
			Callback = function(color)
				if syncing then
					return;
				end;

				NeverLose:SetTheme({ [role] = color });
				Config.OnRole(role , color);
			end,
		});
	end;

	return pickers;
end;

function NeverLose:Unload()
	if not NeverLose.UnloadEnabled then
		return;	
	end;

	for i,v in next , NeverLose.GlobalSignals do
		pcall(v.Disconnect,v)
	end;

	table.clear(NeverLose.GlobalSignals);
	table.clear(NeverLose.NameRegisitry);
	table.clear(NeverLose.RegisiteryColor);

	NeverLose.ScreenGui:Destroy();
end;

return NeverLose;
