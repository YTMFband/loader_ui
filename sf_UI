		KeybindGrad.Rotation = 90
		KeybindGrad.Parent = Keybind
		local KeybindEdge = Instance.new("Frame")
		KeybindEdge.Parent = Keybind
		KeybindEdge.BackgroundColor3 = Color3.fromRGB(255 , 255 , 255)
		KeybindEdge.BackgroundTransparency = 0.88
		KeybindEdge.BorderSizePixel = 0
		KeybindEdge.Position = UDim2.new(0 , 4 , 0 , 1)
		KeybindEdge.Size = UDim2.new(1 , -8 , 0 , 1)
