local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local Lib = {}
Lib.__index = Lib
Lib.Flags = {}

local Tab = {}
Tab.__index = Tab

local Container = {}
Container.__index = Container

local C = {
	Bg = Color3.fromRGB(26, 27, 38),
	Panel = Color3.fromRGB(30, 31, 43),
	Head = Color3.fromRGB(37, 39, 53),
	Field = Color3.fromRGB(39, 41, 57),
	Box = Color3.fromRGB(44, 46, 62),
	Stroke = Color3.fromRGB(58, 61, 80),
	Check = Color3.fromRGB(230, 230, 238),
	Text = Color3.fromRGB(245, 245, 250),
	Dim = Color3.fromRGB(140, 145, 160),
}

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		o[k] = v
	end
	if parent then
		o.Parent = parent
	end
	return o
end

local function corner(p, r)
	return new("UICorner", { CornerRadius = UDim.new(0, r) }, p)
end

local function stroke(p, col, tr)
	return new("UIStroke", { Color = col or C.Stroke, Transparency = tr or 0.3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, p)
end

local function label(parent, props)
	local t = { BackgroundTransparency = 1, BorderSizePixel = 0, Font = Enum.Font.GothamMedium, TextColor3 = C.Text, TextSize = 12, Text = "", TextXAlignment = Enum.TextXAlignment.Left }
	for k, v in pairs(props or {}) do
		t[k] = v
	end
	return new("TextLabel", t, parent)
end

local function register(flag, get, set)
	if flag then
		Lib.Flags[flag] = { GetValue = get, SetValue = set }
	end
end

local function keyName(k)
	if not k then
		return "None"
	end
	return string.sub(k.Name, 1, 6)
end

-- кнопка с клавишей: нажмите, затем нажмите новую клавишу (Esc - отмена, Backspace - очистить)
local function chip(parent, key, xoff, onChange)
	local b = new("TextButton", {
		AutoButtonColor = false, Text = keyName(key), Font = Enum.Font.GothamBold, TextSize = 10,
		TextColor3 = C.Dim, BackgroundColor3 = C.Field, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, xoff, 0.5, 0), Size = UDim2.new(0, 34, 0, 18), ZIndex = 5,
	}, parent)
	corner(b, 5)
	local current = key
	local waiting = false
	b.Activated:Connect(function()
		if waiting then
			return
		end
		waiting = true
		b.Text = "..."
		local conn
		conn = UIS.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.Keyboard then
				return
			end
			conn:Disconnect()
			waiting = false
			if input.KeyCode == Enum.KeyCode.Escape then
				b.Text = keyName(current)
				return
			end
			if input.KeyCode == Enum.KeyCode.Backspace then
				current = nil
			else
				current = input.KeyCode
			end
			b.Text = keyName(current)
			onChange(current)
		end)
	end)
	return b
end

-- строка: название слева, управляющий элемент справа
local function row(self, name, h)
	self.Order = self.Order + 1
	local r = new("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, h or 32), LayoutOrder = self.Order }, self.Frame)
	label(r, { Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(0.55, 0, 1, 0), Text = name or "", TextTruncate = Enum.TextTruncate.AtEnd })
	return r
end

-- широкая строка (как AddWide* в NeverLose): название сверху, элемент на всю ширину снизу.
-- rightPad - место справа от названия (например, под значение слайдера)
local function wideRow(self, name, h, rightPad)
	self.Order = self.Order + 1
	local r = new("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, h or 52), LayoutOrder = self.Order }, self.Frame)
	label(r, { Position = UDim2.new(0, 12, 0, 4), Size = UDim2.new(1, -24 - (rightPad or 0), 0, 16), Text = name or "", TextTruncate = Enum.TextTruncate.AtEnd })
	return r
end

-- ===== элементы (есть у секции и у подвкладки) =====

function Container:AddCheckbox(cfg)
	cfg = cfg or {}
	local r = row(self, cfg.Name, 32)
	local value = cfg.Default and true or false
	local bindKey = cfg.Keybind

	local box = new("TextButton", {
		AutoButtonColor = false, Text = "", BorderSizePixel = 0, BackgroundColor3 = C.Box,
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0, 16, 0, 16),
	}, r)
	corner(box, 4)
	local st = stroke(box, C.Stroke, 0.2)
	local mark = label(box, { Size = UDim2.new(1, 0, 1, 0), Text = "✓", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Color3.fromRGB(20, 20, 28), TextXAlignment = Enum.TextXAlignment.Center, TextTransparency = 1 })

	local function paint()
		box.BackgroundColor3 = value and C.Check or C.Box
		st.Transparency = value and 1 or 0.2
		mark.TextTransparency = value and 0 or 1
	end

	local function setValue(v, fire)
		value = v and true or false
		paint()
		if fire and cfg.Callback then
			cfg.Callback(value)
		end
	end

	paint()
	box.Activated:Connect(function()
		setValue(not value, true)
	end)

	if cfg.Keybind ~= nil then
		chip(r, bindKey, -40, function(k)
			bindKey = k
		end)
	end

	UIS.InputBegan:Connect(function(input, gp)
		if gp or not bindKey then
			return
		end
		if input.KeyCode == bindKey then
			setValue(not value, true)
		end
	end)

	register(cfg.Flag, function() return value end, function(v) setValue(v, true) end)
	return { SetValue = function(_, v) setValue(v, true) end, GetValue = function() return value end }
end

function Container:AddKeybind(cfg)
	cfg = cfg or {}
	local r = row(self, cfg.Name, 32)
	local mode = cfg.Mode or "Hold"
	local key = cfg.Default
	local state = false

	local function setState(v)
		state = v
		if cfg.Callback then
			cfg.Callback(v)
		end
	end

	chip(r, key, -12, function(k)
		key = k
	end)

	UIS.InputBegan:Connect(function(input, gp)
		if gp or not key or input.KeyCode ~= key then
			return
		end
		if mode == "Toggle" then
			setState(not state)
		else
			setState(true)
		end
	end)

	UIS.InputEnded:Connect(function(input)
		if mode == "Hold" and key and input.KeyCode == key then
			setState(false)
		end
	end)

	register(cfg.Flag, function() return key end, function(v) key = v end)
	return { GetKey = function() return key end }
end

function Container:AddSlider(cfg)
	cfg = cfg or {}
	local min, max = cfg.Min or 0, cfg.Max or 100
	local rounding = cfg.Rounding or 0
	local value = cfg.Default or min
	local r = wideRow(self, cfg.Name, 52, 60)

	local vbox = new("TextLabel", {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 4), Size = UDim2.new(0, 46, 0, 16),
		BackgroundColor3 = C.Field, BorderSizePixel = 0, Font = Enum.Font.GothamMedium, TextSize = 10, TextColor3 = C.Text, Text = "",
	}, r)
	corner(vbox, 5)

	-- полоса 26px, скругление 9, заливка с градиентом, белая полоска на конце (Mode = 'Stripe')
	local bar = new("Frame", {
		Position = UDim2.new(0, 12, 0, 26), Size = UDim2.new(1, -24, 0, 22),
		BackgroundColor3 = Color3.fromRGB(10, 13, 21), BorderSizePixel = 0, ClipsDescendants = true,
	}, r)
	corner(bar, 9)
	stroke(bar, C.Stroke, 0.1)

	local fill = new("Frame", {
		Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, ZIndex = 2,
	}, bar)
	corner(fill, 8)
	new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(100, 146, 255)),
			ColorSequenceKeypoint.new(0.45, Color3.fromRGB(78, 127, 252)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(58, 99, 217)),
		}),
		Rotation = 90,
	}, fill)

	local stripe = new("Frame", {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -5, 0, 6), Size = UDim2.new(0, 3, 1, -12),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 0.12, BorderSizePixel = 0, ZIndex = 3,
	}, fill)
	corner(stripe, 2)
	if cfg.Mode == "Plain" then
		stripe.Visible = false
	end

	local hit = new("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 4 }, bar)

	local function paint()
		local p = (value - min) / (max - min)
		fill.Size = UDim2.new(p, 0, 1, 0)
		vbox.Text = string.format("%." .. rounding .. "f", value)
	end

	local function setValue(v, fire)
		v = math.clamp(v, min, max)
		local m = 10 ^ rounding
		value = math.floor(v * m + 0.5) / m
		paint()
		if fire and cfg.Callback then
			cfg.Callback(value)
		end
	end

	paint()

	local dragging = false
	local function fromMouse(x)
		local p = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		setValue(min + p * (max - min), true)
	end

	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			fromMouse(input.Position.X)
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			fromMouse(input.Position.X)
		end
	end)

	register(cfg.Flag, function() return value end, function(v) setValue(v, true) end)
	return { SetValue = function(_, v) setValue(v, true) end, GetValue = function() return value end }
end

function Container:AddDropdown(cfg)
	cfg = cfg or {}
	local values = cfg.Values or {}
	local value = cfg.Default or values[1]
	local r = wideRow(self, cfg.Name, 52)

	local field = new("TextButton", {
		AutoButtonColor = false, Text = "", BorderSizePixel = 0, BackgroundColor3 = C.Field,
		Position = UDim2.new(0, 12, 0, 26), Size = UDim2.new(1, -24, 0, 22), ZIndex = 5,
	}, r)
	corner(field, 6)
	stroke(field, C.Stroke, 0.3)
	local txt = label(field, { Position = UDim2.new(0, 8, 0, 0), Size = UDim2.new(1, -26, 1, 0), Text = tostring(value or ""), TextSize = 10, ZIndex = 6 })
	label(field, { Position = UDim2.new(1, -18, 0, 0), Size = UDim2.new(0, 12, 1, 0), Text = "v", Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = C.Dim, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 6 })

	local list = new("Frame", {
		Position = UDim2.new(0, 0, 1, 4), Size = UDim2.new(1, 0, 0, #values * 22 + 6),
		BackgroundColor3 = C.Panel, BorderSizePixel = 0, Visible = false, ZIndex = 50,
	}, field)
	corner(list, 6)
	stroke(list, C.Stroke, 0.3)
	new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, list)
	new("UIPadding", { PaddingTop = UDim.new(0, 3), PaddingBottom = UDim.new(0, 3) }, list)

	local function setValue(v, fire)
		value = v
		txt.Text = tostring(v)
		if fire and cfg.Callback then
			cfg.Callback(v)
		end
	end

	for i, v in ipairs(values) do
		local it = new("TextButton", {
			AutoButtonColor = false, Text = tostring(v), Font = Enum.Font.GothamMedium, TextSize = 10, TextColor3 = C.Text,
			BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = i, ZIndex = 51,
		}, list)
		it.Activated:Connect(function()
			setValue(v, true)
			list.Visible = false
		end)
	end

	field.Activated:Connect(function()
		list.Visible = not list.Visible
	end)

	register(cfg.Flag, function() return value end, function(v) setValue(v, true) end)
	return { SetValue = function(_, v) setValue(v, true) end, GetValue = function() return value end }
end

-- подвкладки внутри секции: строка кнопок вверху секции, каждая со своим набором элементов
function Container:AddSubTabs(names)
	local bar = new("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 0 }, self.Frame)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 4) }, bar)
	new("UIPadding", { PaddingLeft = UDim.new(0, 10) }, bar)

	local subs, btns = {}, {}

	local function activate(name)
		for n, s in pairs(subs) do
			s.Frame.Visible = (n == name)
		end
		for n, b in pairs(btns) do
			b.BackgroundTransparency = (n == name) and 0 or 1
			b.TextColor3 = (n == name) and C.Text or C.Dim
		end
	end

	for _, n in ipairs(names) do
		local b = new("TextButton", {
			AutoButtonColor = false, Text = n, Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = C.Dim,
			BackgroundColor3 = C.Field, BackgroundTransparency = 1, BorderSizePixel = 0,
			AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 0, 24),
		}, bar)
		corner(b, 6)
		new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, b)

		local frame = new("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Visible = false }, self.Frame)
		new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, frame)

		subs[n] = setmetatable({ Frame = frame, Order = 0 }, Container)
		btns[n] = b
		b.Activated:Connect(function()
			activate(n)
		end)
	end

	if names[1] then
		activate(names[1])
	end
	return subs
end

-- ===== секции =====

function Tab:AddSection(cfg)
	cfg = cfg or {}
	local col = (cfg.Side == "right") and self.Right or self.Left
	local frame = new("Frame", { BackgroundColor3 = C.Panel, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = #col:GetChildren() + 1 }, col)
	corner(frame, 10)
	stroke(frame, C.Stroke, 0.4)
	new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, frame)

	local head = new("Frame", { BackgroundColor3 = C.Head, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 32), LayoutOrder = 0 }, frame)
	label(head, { Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -24, 1, 0), Text = cfg.Name or "Section", Font = Enum.Font.GothamBold, TextSize = 12 })

	local body = new("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1 }, frame)
	new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, body)
	new("UIPadding", { PaddingBottom = UDim.new(0, 6) }, body)

	return setmetatable({ Frame = body, Order = 0 }, Container)
end

-- ===== окно =====

function Lib:SelectTab(tab)
	for _, t in ipairs(self.Tabs) do
		local on = (t == tab)
		t.Page.Visible = on
		t.Button.BackgroundTransparency = on and 0 or 1
		t.Label.TextColor3 = on and C.Text or C.Dim
		if t.Icon then
			t.Icon.TextColor3 = on and C.Text or C.Dim
		end
	end
	self.Current = tab
end

function Lib:AddTab(cfg)
	cfg = cfg or {}
	local btn = new("TextButton", {
		AutoButtonColor = false, Text = "", BorderSizePixel = 0, BackgroundColor3 = C.Field, BackgroundTransparency = 1,
		Size = UDim2.new(0, 0, 0, 32), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = #self.Tabs + 1,
	}, self.TabBar)
	corner(btn, 9)
	new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, btn)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 7) }, btn)

	local icon = nil
	if cfg.Icon then
		icon = label(btn, { Size = UDim2.new(0, 14, 0, 14), LayoutOrder = 1, Text = cfg.Icon, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = C.Dim, TextXAlignment = Enum.TextXAlignment.Center })
	end
	local lab = label(btn, { Size = UDim2.new(0, 0, 0, 16), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = 2, Text = cfg.Name or "Tab", TextColor3 = C.Dim })

	local page = new("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), Visible = false }, self.Body)
	local inner = new("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, -24, 1, -12), Position = UDim2.new(0, 12, 0, 6) }, page)
	local left = new("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(0.5, -6, 1, 0) }, inner)
	local right = new("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(0.5, -6, 1, 0), Position = UDim2.new(0.5, 6, 0, 0) }, inner)
	new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10) }, left)
	new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10) }, right)

	local tab = setmetatable({ Window = self, Button = btn, Label = lab, Icon = icon, Page = page, Left = left, Right = right }, Tab)
	table.insert(self.Tabs, tab)
	btn.Activated:Connect(function()
		self:SelectTab(tab)
	end)
	if #self.Tabs == 1 then
		self:SelectTab(tab)
	end
	return tab
end

function Lib:CreateWindow(cfg)
	cfg = cfg or {}
	local self = setmetatable({ Tabs = {}, Current = nil }, Lib)

	local okHui, hui = pcall(function()
		return gethui()
	end)
	local gui = new("ScreenGui", { Name = "NewLib", ResetOnSpawn = false, DisplayOrder = 100, IgnoreGuiInset = true }, (okHui and typeof(hui) == "Instance") and hui or Players.LocalPlayer:WaitForChild("PlayerGui"))

	local main = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = cfg.Size or UDim2.new(0, 920, 0, 600),
		BackgroundColor3 = C.Bg, BorderSizePixel = 0, ClipsDescendants = true,
	}, gui)
	corner(main, 14)
	stroke(main, C.Stroke, 0.2)
	self.Gui = gui
	self.Main = main

	-- шапка
	local head = new("Frame", { BackgroundColor3 = C.Head, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 44) }, main)
	-- шапка скруглена как окно; нижний край возвращаем прямым подложкой
	corner(head, 14)
	new("Frame", { BackgroundColor3 = C.Head, BorderSizePixel = 0, Position = UDim2.new(0, 0, 1, -14), Size = UDim2.new(1, 0, 0, 14) }, head)
	label(head, { Position = UDim2.new(0, 16, 0, 0), Size = UDim2.new(0, 260, 1, 0), Text = cfg.Name or "Window", Font = Enum.Font.GothamBold, TextSize = 14 })
	if cfg.Subtitle then
		label(head, { Position = UDim2.new(0, 16 + 8 + #(cfg.Name or "Window") * 8, 0, 0), Size = UDim2.new(0, 200, 1, 0), Text = cfg.Subtitle, TextColor3 = C.Dim, TextSize = 11 })
	end
	label(head, { Position = UDim2.new(1, -176, 0, 0), Size = UDim2.new(0, 160, 1, 0), Text = cfg.User or "", TextColor3 = C.Dim, TextXAlignment = Enum.TextXAlignment.Right })

	-- перетаскивание за шапку
	local dragging, startPos, startMouse = false, nil, nil
	head.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			startPos = main.Position
			startMouse = input.Position
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	UIS.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local d = input.Position - startMouse
			main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)

	-- ряд вкладок
	local tabBar = new("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 0, 0, 44), Size = UDim2.new(1, 0, 0, 52),
		CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollBarThickness = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
	}, main)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 6) }, tabBar)
	new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, tabBar)
	self.TabBar = tabBar

	self.Body = new("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 0, 0, 96), Size = UDim2.new(1, 0, 1, -96) }, main)

	-- открытие / закрытие клавишей (по умолчанию Insert)
	local toggleKey = cfg.Key or Enum.KeyCode.Insert
	UIS.InputBegan:Connect(function(input, gp)
		if not gp and input.KeyCode == toggleKey then
			gui.Enabled = not gui.Enabled
		end
	end)

	return self
end

return Lib
