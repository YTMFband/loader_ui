	-- ШИРОКИЙ dropdown (тест): подпись сверху, поле на всю ширину, список раскрывается прямо в секции, с поиском.
	-- Значения те же, что у AddDropdown: одиночный = значение, Multi = { [значение] = true }
	function idx:AddWideDropdown(Config)
		Config = NeverLose:ProcessParams(Config , {
			Name = 'Dropdown',
			Values = {},
			Default = nil,
			Multi = false,
			Search = true,         -- поле поиска вверху списка
			MaxVisible = 6,        -- сколько пунктов видно без прокрутки
			CloseOnSelect = true,  -- одиночный выбор сразу закрывает список
			Placeholder = 'Select',
			Size = nil,            -- масштаб ВСЕГО dropdown: nil/1 = как сейчас, 0.8 = меньше на 20%, 1.1 = больше. Или 'Small' / 'Medium' / 'Default' / 'Large'
			Flag = nil,
			Callback = EmptyFunction,
		});

		Config.Default = NeverLose.ProcessDropdown(Config.Default);

		if Config.Multi then
			if type(Config.Default) == 'string' then
				Config.Default = { [Config.Default] = true };
			elseif type(Config.Default) ~= 'table' then
				Config.Default = {};
			end;
		end;

		local Z = LayerIndex;
		local Lib = {};
		local IsOpen = false;
		local Items = {};
		local Signals = {};
		-- масштаб всего элемента (подпись, поле, список, шрифты, отступы); без Size всё как раньше
		local Scale = 1;

		if type(Config.Size) == 'number' then
			Scale = Config.Size;
		elseif type(Config.Size) == 'string' then
			Scale = ({ small = 0.8 , medium = 0.9 , default = 1 , large = 1.1 })[string.lower(Config.Size)] or 1;
		end;

		Scale = math.clamp(Scale , 0.6 , 1.4);

		local function S(n)
			return math.floor(n * Scale + 0.5);
		end;

		-- размер текста не масштабируется: Size меняет только геометрию
		local NameSize = 13;
		local FontSize = 12;
		local IconSize = math.clamp(S(16) , 11 , 18);
		local ChevSize = S(20);
		local LabelH = S(15);
		local FieldY = S(26);
		local FieldH = S(26);
		local SearchH = S(24);
		local Pad = S(3);
		local ItemH = S(25);
		local ClosedH = FieldY + FieldH + S(6);
		local PanelTop = FieldY + FieldH + S(4);

		local function make(class , props , parent)
			local obj = Instance.new(class);

			obj.Name = NeverLose.RandomString();

			if obj:IsA('GuiObject') then
				obj.BorderSizePixel = 0;
				obj.BorderColor3 = Color3.fromRGB(0 , 0 , 0);
			end;

			for k , v in next , props do
				obj[k] = v;
			end;

			obj.Parent = parent;

			return obj;
		end;

		local function corner(parent , r)
			return make('UICorner' , { CornerRadius = UDim.new(0 , r) } , parent);
		end;

		local function stroke(parent)
			return make('UIStroke' , { Color = NeverLose.Theme.Stroke , Transparency = 0.65 } , parent);
		end;

