    Default = false,
    Flag = "RevolverGmEnabled",
    Callback = function(val)
        if not val then
            for i=1, #heartbeat do
                if heartbeat[i] == lfunctions.RenderRevolver then
                    table.remove(heartbeat, i)
                end
            end
        end

        if val then
            heartbeat[#heartbeat+1] = lfunctions.RenderRevolver
        end
    end
})

