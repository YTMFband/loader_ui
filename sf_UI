		---------------------------------------------------------- teleport / view
		local ViewConn = nil;

		local function stopView()
			if ViewConn then
				ViewConn:Disconnect();
				ViewConn = nil;
			end;

			Viewing = nil;

			local cam = workspace.CurrentCamera;
			local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass('Humanoid');

			if cam and hum then
				cam.CameraSubject = hum;
			end;

			updateButtons();
		end;

		function PlayerList:Teleport(player)
			player = player or Selected;

			if typeof(player) ~= 'Instance' or player == LocalPlayer then
				return false;
			end;

			local mine = LocalPlayer.Character;
			local theirs = player.Character;

			if not mine or not theirs then
				return false;
			end;

			mine:PivotTo(theirs:GetPivot() * CFrame.new(0 , 0 , 3));

			return true;
		end;

		function PlayerList:View(player)
			player = player or Selected;

			if typeof(player) ~= 'Instance' or player == LocalPlayer then
				return false;
			end;

			if Viewing == player then
				stopView(); -- повторное нажатие выключает просмотр
				return true;
			end;

			local cam = workspace.CurrentCamera;
			local hum = player.Character and player.Character:FindFirstChildOfClass('Humanoid');

			if not cam or not hum then
				return false;
			end;

			if ViewConn then
				ViewConn:Disconnect();
				ViewConn = nil;
			end;

			Viewing = player;
			cam.CameraSubject = hum;

			ViewConn = NeverLose:AddSignal(player.CharacterAdded:Connect(function(char)
				local h = char:WaitForChild('Humanoid' , 5);

				if h and Viewing == player and workspace.CurrentCamera then
					workspace.CurrentCamera.CameraSubject = h;
				end;
			end));

			updateButtons();

			return true;
		end;

		function PlayerList:Unview()
			if Viewing then
				stopView();
			end;
		end;

		function PlayerList:GetViewing()
			return Viewing;
		end;

		NeverLose:AddSignal(LocalPlayer.CharacterAdded:Connect(function()
			if Viewing then
				stopView();
			end;
		end));

		function PlayerList:GetByPriority(priority)
			local out = {};

			for player in next , Rows do
				if getPriorityName(player) == priority then
					table.insert(out , player);
				end;
			end;

			return out;
		end;

		function PlayerList:GetValue()
			local copy = {};

			for k , v in next , PriorityMap do
				copy[k] = v;
			end;

			return copy;
		end;

		function PlayerList:SetValue(data)
			if type(data) ~= 'table' then
				return;
			end;

			table.clear(PriorityMap);

			for k , v in next , data do
				if v == 'Whitelist' then
					PriorityMap[tostring(k)] = v;
				end;
			end;

			for player in next , Rows do
				updateRow(player);
			end;

			updateInfo();
		end;

		----------------------------------------------------------------- buttons
		local PanelButtons = {
			{ Name = 'Whitelist' , Action = function(pl) PlayerList:SetWhitelisted(pl , getPriorityName(pl) ~= 'Whitelist'); end },
			{ Name = 'Teleport'  , Action = function(pl) PlayerList:Teleport(pl); end },
			{ Name = 'View'      , Action = function(pl) PlayerList:View(pl); end },
		};

		for i , item in next , PanelButtons do
			local Button = make('TextButton' , {
				AutoButtonColor = false,
				BackgroundColor3 = NeverLose.Theme.Deep,
				Size = UDim2.new(1 / 3 , -3 , 1 , 0),
				ZIndex = Z + 2,
				Font = Enum.Font.GothamMedium,
				Text = item.Name,
				TextColor3 = NeverLose.Theme.TextDim,
				TextSize = 11,
				LayoutOrder = i,
			} , ButtonRow);

			corner(Button , 6);

			PriorityButtons[item.Name] = {
				Button = Button,
				Stroke = stroke(Button),
			};

			NeverLose:AddSignal(Button.MouseButton1Click:Connect(function()
				if Selected and Selected ~= LocalPlayer then
					item.Action(Selected);
				end;
			end));
		end;

		----------------------------------------------------------------- rows
		local function addPlayer(player)
			if Rows[player] then
				return;
			end;

			local Button = make('TextButton' , {
				AutoButtonColor = false,
				BackgroundColor3 = NeverLose.Theme.Elem,
				BackgroundTransparency = 1,
				Size = UDim2.new(1 , -4 , 0 , 22),
				Text = '',
			} , List);
			corner(Button , 6);

			local function cell(x , w , text)
				return make('TextLabel' , {
					BackgroundTransparency = 1,
					Position = UDim2.new(x , 8 , 0 , 0),
					Size = UDim2.new(w , -8 , 1 , 0),
					ZIndex = Z + 1,
					Font = Enum.Font.GothamMedium,
					Text = text,
					TextColor3 = NeverLose.Theme.Text,
					TextSize = 12,
					TextTransparency = 0.2,
					TextTruncate = Enum.TextTruncate.AtEnd,
					TextXAlignment = Enum.TextXAlignment.Left,
				} , Button);
			end;

			local row = {
				Button = Button,
				Name = cell(0 , 0.5 , player.Name),
				Team = cell(0.5 , 0.25 , getCrewText(player)),
				Priority = cell(0.75 , 0.25 , getPriorityName(player)),
			};

			row.Team.TextColor3 = NeverLose.Theme.TextDim;
			Rows[player] = row;

			NeverLose:AddSignal(Button.MouseEnter:Connect(function()
				if player ~= Selected then
					NeverLose.PlayAnimate(Button , SlowyTween , { BackgroundTransparency = 0.6 });
				end;
			end));

			NeverLose:AddSignal(Button.MouseLeave:Connect(function()
				if player ~= Selected then
					NeverLose.PlayAnimate(Button , SlowyTween , { BackgroundTransparency = 1 });
				end;
			end));

			NeverLose:AddSignal(Button.MouseButton1Click:Connect(function()
				PlayerList:Select(player);
			end));

			NeverLose:AddSignal(player:GetPropertyChangedSignal('Team'):Connect(function()
				updateRow(player);

				if player == Selected then
					updateInfo();
				end;
			end));

			task.spawn(function()
				local ok , image = pcall(Players.GetUserThumbnailAsync , Players , player.UserId , Enum.ThumbnailType.HeadShot , Enum.ThumbnailSize.Size100x100);

				if ok and image then
					Thumbs[player.UserId] = image;

					if player == Selected then
						Avatar.Image = image;
					end;
				end;
			end);

			updateRow(player);
			resort();
		end;

		local function removePlayer(player)
			local row = Rows[player];

			if not row then
				return;
			end;

			if player == Selected then
				PlayerList:Select(nil);
			end;

			if Viewing == player then
				stopView();
			end;

			Rows[player] = nil;
			row.Button:Destroy();
		end;

		for _ , player in next , Players:GetPlayers() do
			addPlayer(player);
		end;

		NeverLose:AddSignal(Players.PlayerAdded:Connect(addPlayer));
		NeverLose:AddSignal(Players.PlayerRemoving:Connect(removePlayer));

		NeverLose:AddSignal(SearchBox:GetPropertyChangedSignal('Text'):Connect(function()
			Search = string.lower(SearchBox.Text);

			for player in next , Rows do
				local id = getCrewId(player);

				if id then
					requestCrew(id);
				end;
			end;

			for player in next , Rows do
				updateRow(player);
			end;
		end));

		----------------------------------------------------------------- render
		PlayerList.SetRender = function(value)
			Container.Visible = value and true or false;
		end;

		PlayerList.SetRender(Signel:GetValue());
		Signel:Connect(PlayerList.SetRender);

		updateInfo();

		if Config.Flag then
			NeverLose.Flags[Config.Flag] = PlayerList;
		end;

		return PlayerList;
	end;

	return idx;
end;

