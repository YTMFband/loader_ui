		Icon.Position = UDim2.new(0.5 , 0 , 0.5 , 0);
		Icon.Size = UDim2.new(1 , 0 , 1 , 0);
		Icon.ZIndex = 164;
		Icon.Font = Enum.Font.GothamBold;
		Icon.Text = 'N';
		Icon.TextColor3 = NeverLose.Theme.Text;

		local IconImage = Instance.new('ImageLabel');

		IconImage.Name = NeverLose.RandomString();
		IconImage.Parent = Gui;
		IconImage.AnchorPoint = Vector2.new(0.5 , 0.5);
		IconImage.BackgroundTransparency = 1;
		IconImage.BorderSizePixel = 0;
		IconImage.Position = UDim2.new(0.5 , 0 , 0.5 , 0);
		IconImage.Size = UDim2.fromOffset(20 , 20);
		IconImage.ScaleType = Enum.ScaleType.Fit;
		IconImage.ZIndex = 164;
		IconImage.Visible = false;

		local IconImageCorner = Instance.new('UICorner');
		IconImageCorner.Parent = IconImage;

		local Halo = Instance.new('UIStroke');

		Halo.Parent = Gui;
		Halo.Color = NeverLose.AccentColor;
		Halo.Thickness = 7;
		Halo.Transparency = 1;
		Halo.ApplyStrokeMode = Enum.ApplyStrokeMode.Border;

		MenuBtn = { Gui = Gui , Corner = Corner , Icon = Icon , Image = IconImage , ImageCorner = IconImageCorner , Stroke = Stroke , Halo = Halo };

		-- MenuBtn используется как таблица; Visible / Size / Position пробрасываем на Gui
		setmetatable(MenuBtn , {
			__index = function(_ , k)
				return Gui[k];
			end,
			__newindex = function(_ , k , v)
				Gui[k] = v;
			end,
