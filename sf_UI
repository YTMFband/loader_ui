	Root.ZIndex = Z;
	Root.Visible = Config.Visible;

	RootCorner.CornerRadius = UDim.new(0 , 8);
	RootCorner.Parent = Root;

	RootStroke.Color = NeverLose.Theme.Stroke;
	RootStroke.Transparency = 0.65;
	RootStroke.Parent = Root;

	Header.Name = NeverLose.RandomString();
	Header.Parent = Root;
	Header.BackgroundColor3 = Color3.fromRGB(255 , 255 , 255);
	Header.BackgroundTransparency = 0;
	Header.BorderSizePixel = 0;
	Header.Size = UDim2.new(1 , 0 , 0 , 26);
	Header.ZIndex = Z + 1;

	local function headSeq(base)
		return ColorSequence.new(base:Lerp(Color3.new(1 , 1 , 1) , 0.07) , base);
	end;

	local HeaderGrad = Instance.new('UIGradient');
	HeaderGrad.Color = headSeq(NeverLose.Theme.Field);
	HeaderGrad.Rotation = 90;
	HeaderGrad.Parent = Header;

	local HeaderEdge = Instance.new('Frame');
	HeaderEdge.Parent = Header;
	HeaderEdge.BackgroundColor3 = Color3.fromRGB(255 , 255 , 255);
	HeaderEdge.BackgroundTransparency = 0.88;
	HeaderEdge.BorderSizePixel = 0;
	HeaderEdge.Position = UDim2.new(0 , 4 , 0 , 1);
	HeaderEdge.Size = UDim2.new(1 , -8 , 0 , 1);
	HeaderEdge.ZIndex = Z + 2;

	table.insert(NeverLose.ThemeListeners , function()
		if not Root.Parent then
			return false;
		end;

		HeaderGrad.Color = headSeq(NeverLose.Theme.Field);
	end);

	Title.Name = NeverLose.RandomString();
	Title.Parent = Header;
	Title.BackgroundTransparency = 1;
	Title.BorderSizePixel = 0;
	Title.Position = UDim2.new(0 , 10 , 0 , 0);
	Title.Size = UDim2.new(1 , -20 , 1 , 0);
	Title.ZIndex = Z + 2;
	Title.Font = Enum.Font.GothamMedium;
	Title.Text = Config.Name;
	Title.TextColor3 = NeverLose.Theme.Text;
	Title.TextSize = 12;
	Title.TextTransparency = 0.15;
	Title.TextXAlignment = Enum.TextXAlignment.Left;

	AccentLine.Name = NeverLose.RandomString();
	AccentLine.Parent = Header;
	AccentLine.AnchorPoint = Vector2.new(0.5 , 1);
	AccentLine.BackgroundColor3 = NeverLose.Theme.Stroke;
	AccentLine.BorderSizePixel = 0;
	AccentLine.Position = UDim2.new(0.5 , 0 , 1 , 0);
	AccentLine.Size = UDim2.new(1 , -16 , 0 , 1);
	AccentLine.ZIndex = Z + 2;

	AccentGradient.Transparency = NumberSequence.new{
		NumberSequenceKeypoint.new(0 , 1),
		NumberSequenceKeypoint.new(0.5 , 0),
		NumberSequenceKeypoint.new(1 , 1),
	};
	AccentGradient.Parent = AccentLine;

	Holder.Name = NeverLose.RandomString();
	Holder.Parent = Root;
	Holder.BackgroundTransparency = 1;
	Holder.BorderSizePixel = 0;
	Holder.Position = UDim2.new(0 , 0 , 0 , 28);
	Holder.Size = UDim2.new(1 , 0 , 0 , 0);
	Holder.ZIndex = Z + 1;

	HolderLayout.Parent = Holder;
	HolderLayout.SortOrder = Enum.SortOrder.LayoutOrder;
	HolderLayout.Padding = UDim.new(0 , 0);

	local function resize()
		local h = HolderLayout.AbsoluteContentSize.Y;

		NeverLose.PlayAnimate(Root , SlowyTween , {
			Size = UDim2.new(0 , Config.Width , 0 , 28 + h + (h > 0 and 4 or 0)),
		});
	end;

	NeverLose:AddSignal(HolderLayout:GetPropertyChangedSignal('AbsoluteContentSize'):Connect(resize));

	NeverLose.Drag(Header , Root , 0.05);

	local function normalizeKey(k)
		if typeof(k) == 'EnumItem' then
			return k.Name;
		end;

		return k;
	end;

	local function resolveKey(entry)
		if entry.Flag and NeverLose.Flags[entry.Flag] and NeverLose.Flags[entry.Flag].GetValue then
			return normalizeKey(NeverLose.Flags[entry.Flag]:GetValue());
		end;

		return normalizeKey(entry.Key);
	end;

	local function keyText(key)
		if not key or key == 'None' then
			return 'None';
		end;

		return NeverLose:KeyCodeToStr(key);
	end;

	local function snapshot(entry)
		if entry.Source then
			return normalizeKey(entry.Source:GetValue()) , entry.Source.Mode , entry.Source:GetState() , entry.Source.Name;
		end;

		return resolveKey(entry) , entry.Mode , entry.Active , entry.Name;
	end;

	local function refresh(entry)
		local key , mode , active , name = snapshot(entry);
		local hasKey = key ~= nil and key ~= 'None' and key ~= '';

		entry.NameLabel.Text = name or 'Keybind';
		entry.KeyLabel.Text = string.format('[%s] %s' , keyText(key) , mode);
		entry.Row.Visible = (mode == 'Once') or (hasKey and (active or Config.ShowInactive));

		NeverLose.PlayAnimate(entry.NameLabel , SlowyTween , {
			TextTransparency = active and 0.1 or 0.6,
		});

		NeverLose.PlayAnimate(entry.KeyLabel , SlowyTween , {
			TextTransparency = active and 0.3 or 0.7,
		});

		entry.NameLabel.TextColor3 = active and NeverLose.AccentColor or Color3.fromRGB(255 , 255 , 255);
	end;

	function KeybindList:Add(Entry)
		Entry = NeverLose:ProcessParams(Entry , {
			Name = 'Keybind',
			Key = nil,        -- 'E' / Enum.KeyCode.E / 'M1B' / 'M2B'
			Flag = nil,       -- флаг из AddKeybind: клавиша подтянется сама
			Mode = 'Hold',    -- 'Hold' | 'Toggle' | 'Always'
			Default = false,
			Callback = EmptyFunction, -- (active)
			Source = nil,    -- объект AddKeybind (подставляется автоматически)
		});

		local Row = Instance.new('Frame');
		local NameLabel = Instance.new('TextLabel');
		local KeyLabel = Instance.new('TextLabel');

		Row.Name = NeverLose.RandomString();
		Row.Parent = Holder;
		Row.BackgroundTransparency = 1;
		Row.BorderSizePixel = 0;
		Row.Size = UDim2.new(1 , 0 , 0 , 20);
		Row.ZIndex = Z + 1;
		Row.LayoutOrder = #Entries + 1;

		NameLabel.Name = NeverLose.RandomString();
		NameLabel.Parent = Row;
		NameLabel.BackgroundTransparency = 1;
		NameLabel.BorderSizePixel = 0;
		NameLabel.Position = UDim2.new(0 , 10 , 0 , 0);
		NameLabel.Size = UDim2.new(0.5 , -10 , 1 , 0);
		NameLabel.ZIndex = Z + 2;
		NameLabel.Font = Enum.Font.GothamMedium;
		NameLabel.Text = (Entry.Source and Entry.Source.Name) or Entry.Name;
		NameLabel.TextColor3 = NeverLose.Theme.Text;
		NameLabel.TextSize = 12;
		NameLabel.TextTruncate = Enum.TextTruncate.AtEnd;
		NameLabel.TextXAlignment = Enum.TextXAlignment.Left;

		KeyLabel.Name = NeverLose.RandomString();
		KeyLabel.Parent = Row;
		KeyLabel.BackgroundTransparency = 1;
		KeyLabel.BorderSizePixel = 0;
		KeyLabel.Position = UDim2.new(0.5 , 0 , 0 , 0);
		KeyLabel.Size = UDim2.new(0.5 , -10 , 1 , 0);
		KeyLabel.ZIndex = Z + 2;
		KeyLabel.Font = Enum.Font.GothamMedium;
		KeyLabel.Text = '';
		KeyLabel.TextColor3 = NeverLose.Theme.TextDim;
		KeyLabel.TextSize = 11;
		KeyLabel.TextXAlignment = Enum.TextXAlignment.Right;

		local entry = {
			Row = Row,
			NameLabel = NameLabel,
			KeyLabel = KeyLabel,
			Name = Entry.Name,
			Key = Entry.Key,
			Flag = Entry.Flag,
			Source = Entry.Source,
			Mode = Entry.Mode,
			Callback = Entry.Callback,
			Active = (Entry.Mode == 'Always') or Entry.Default,
		};

		local Item = {};

		function Item:SetActive(v)
			if entry.Source then
				return;
			end;

			v = v and true or false;

			if entry.Active == v then
				return;
			end;

			entry.Active = v;
			refresh(entry);
			task.spawn(entry.Callback , v);
		end;

		function Item:GetActive()
			return entry.Active;
		end;

		function Item:SetName(n)
			entry.Name = n;
			NameLabel.Text = n;
		end;

		function Item:SetKey(k)
			entry.Key = k;
			refresh(entry);
		end;

		function Item:SetMode(m)
			entry.Mode = m;

			if m == 'Always' then
				entry.Active = true;
			elseif m == 'Hold' then
				entry.Active = false;
			end;

			refresh(entry);
		end;

		function Item:Remove()
			if entry.Conn then
				entry.Conn:Disconnect();
			end;

			local i = table.find(Entries , entry);

			if i then
				table.remove(Entries , i);
			end;

			Row:Destroy();
		end;

		table.insert(Entries , entry);
		refresh(entry);

		if entry.Source then
			entry.Conn = entry.Source.Changed:Connect(function()
				refresh(entry);
			end);
		end;

		-- клавиша могла быть изменена в AddKeybind: обновляем текст, когда меняется флаг
		if entry.Flag then
			task.spawn(function()
				local last = resolveKey(entry);

				while Row.Parent do
					task.wait(0.25);

					local now = resolveKey(entry);

					if now ~= last then
						last = now;
						refresh(entry);
					end;
				end;
			end);
		end;

		return Item;
	end;

	local function matches(key , input)
		if not key or key == 'None' then
			return false;
		end;

		if key == 'M1B' then
			return input.UserInputType == Enum.UserInputType.MouseButton1;
		elseif key == 'M2B' then
			return input.UserInputType == Enum.UserInputType.MouseButton2;
		end;

		return input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode.Name == key;
	end;

	NeverLose:AddSignal(UserInputService.InputBegan:Connect(function(input , gp)
		if gp or UserInputService:GetFocusedTextBox() then
			return;
		end;

		for _ , entry in next , Entries do
			if not entry.Source and entry.Mode ~= 'Always' and matches(resolveKey(entry) , input) then
				if entry.Mode == 'Toggle' then
					entry.Active = not entry.Active;
				else
					entry.Active = true;
				end;

				refresh(entry);
				task.spawn(entry.Callback , entry.Active);
			end;
		end;
	end));

	NeverLose:AddSignal(UserInputService.InputEnded:Connect(function(input)
		for _ , entry in next , Entries do
			if not entry.Source and entry.Mode == 'Hold' and entry.Active and matches(resolveKey(entry) , input) then
				entry.Active = false;
				refresh(entry);
				task.spawn(entry.Callback , false);
			end;
		end;
	end));

	function KeybindList:SetVisible(v)
		Root.Visible = v and true or false;
	end;

	function KeybindList:Toggle()
		Root.Visible = not Root.Visible;
	end;

	function KeybindList:SetShowInactive(v)
		Config.ShowInactive = v and true or false;

		for _ , entry in next , Entries do
			refresh(entry);
		end;
	end;

	function KeybindList:SetTitle(t)
		Title.Text = t;
	end;

	KeybindList.Root = Root;
	resize();

	NeverLose.KeybindList = KeybindList;

	-- подхватываем все AddKeybind, созданные до списка
	for _ , kb in next , NeverLose.KeybindRegistry or {} do
		if kb.ShowInList then
			kb.ListItem = KeybindList:Add({ Source = kb });
		end;
	end;

	return KeybindList;
end;

----------------------------------------------------------------------------------------------------
-- MOBILE: плавающая кнопка меню + экранные кнопки функций
----------------------------------------------------------------------------------------------------
NeverLose.MobileConfig = NeverLose.MobileConfig or {
	Enabled = true,
	Force = nil,                       -- true: показывать и на ПК (для теста), false: никогда
	MenuButton = true,
	MenuButtonSize = 40,
	MenuButtonCorner = 20,             -- >= размер / 2 = круг
	MenuButtonIcon = 'N',              -- 'N' (текст) | 'icon:menu' (иконка библиотеки) | 'rbxassetid://123' или 123 (картинка)
	MenuButtonFillCorner = nil,       -- закругление в режиме Fill (nil = авто: 25% размера, как у иконки приложения)
	MenuButtonIconScale = 0.55,        -- размер иконки относительно кнопки (0..1)
	MenuButtonStyle = 'Auto',          -- 'Auto' (картинка = Fill) | 'Fill' (картинка на всю кнопку) | 'Default' (картинка внутри тёмного круга)
	MenuButtonIconColor = nil,         -- Color3: цвет иконки/текста (nil = белый, картинка без окраски)
	ShowFunctionButtons = true,
	ButtonSize = Vector2.new(76 , 40),
	ButtonCorner = 8,
	ShowMode = true,                   -- показывать Hold / Toggle под названием кнопки
	EdgeMargin = 12,                   -- px: минимальный отступ кнопок от краёв экрана (плюс безопасная зона выреза телефона)
	EditShowAll = false,               -- false: в Edit layout только действующие кнопки; true: и скрытые по ShowWhen / SetVisible(false)
	HideWhenMenuOpen = true,
	Transparency = 0.15,
};

NeverLose.Mobile = NeverLose.Mobile or {
	Buttons = {},
	Layout = {},   -- [ключ] = { x = scale, y = scale }
	Edit = false,
};

function NeverLose:IsMobileUI()
	local Cfg = NeverLose.MobileConfig;

	if not Cfg.Enabled or Cfg.Force == false then
		return false;
	end;

	if Cfg.Force then
		return true;
	end;

	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled;
end;

do
	local Mobile = NeverLose.Mobile;
	local Holder , MenuBtn , DonePill = nil , nil , nil;
	local MenuPaint = nil;
	local FillMode = false;

	local function Cfg()
		return NeverLose.MobileConfig;
	end;

	local function ensureHolder()
		if Holder and Holder.Parent then
			return Holder;
		end;

		Holder = Instance.new('Frame');
		Holder.Name = NeverLose.RandomString();
		Holder.Parent = NeverLose.ScreenGui;
		Holder.BackgroundTransparency = 1;
		Holder.BorderSizePixel = 0;
		Holder.Size = UDim2.new(1 , 0 , 1 , 0);
		Holder.ZIndex = 160;
		Holder.Visible = false;

		NeverLose:AddSignal(Holder:GetPropertyChangedSignal('AbsoluteSize'):Connect(function()
			Mobile:ClampAll(); -- поворот экрана / смена размера окна игры
		end));

		return Holder;
	end;

	local function bindPointer(gui , onDown , onMove , onUp)
		NeverLose:AddSignal(gui.InputBegan:Connect(function(input)
			local t = input.UserInputType;

			if t ~= Enum.UserInputType.Touch and t ~= Enum.UserInputType.MouseButton1 then
				return;
			end;

			local start = input.Position;
			local moveConn , endConn;

			Mobile.Busy = (Mobile.Busy or 0) + 1;
			onDown(input);

			moveConn = UserInputService.InputChanged:Connect(function(i)
				if i == input or (t == Enum.UserInputType.MouseButton1 and i.UserInputType == Enum.UserInputType.MouseMovement) then
					onMove(Vector2.new(i.Position.X - start.X , i.Position.Y - start.Y));
				end;
			end);

			endConn = input.Changed:Connect(function()
				local st = input.UserInputState;

				if st == Enum.UserInputState.End or st == Enum.UserInputState.Cancel then
					moveConn:Disconnect();
					endConn:Disconnect();
					Mobile.Busy = math.max((Mobile.Busy or 1) - 1 , 0);
					onUp();
				end;
			end);
		end));
	end;

	-- центр кнопки в координатах Holder (раньше брались координаты экрана)
	local function center(gui)
		return gui.AbsolutePosition - Holder.AbsolutePosition + gui.AbsoluteSize / 2;
	end;

	-- видимая область: меньшее из Holder и экрана камеры, минус безопасная зона (вырез телефона) и отступ
	local function safeRect()
		local vp = Holder.AbsoluteSize;
		local cam = workspace.CurrentCamera;

		if cam then
			local v = cam.ViewportSize;

			if v.X > 0 and v.Y > 0 then
				vp = Vector2.new((vp.X > 0) and math.min(vp.X , v.X) or v.X , (vp.Y > 0) and math.min(vp.Y , v.Y) or v.Y);
			end;
		end;

		local l , t , r , bt = 0 , 0 , 0 , 0;
		local ok , z = pcall(function()
			return game:GetService('GuiService'):GetSafeZoneOffsets();
		end);

		if ok and type(z) == 'table' then
			l , t , r , bt = z.left or 0 , z.top or 0 , z.right or 0 , z.bottom or 0;
		end;

		local m = Cfg().EdgeMargin or 12;

		return vp , l + m , t + m , r + m , bt + m;
	end;

	-- центр (в пикселях Holder) -> scale-позиция внутри безопасной зоны; NaN и выход за экран исправляются
	local function clampedScale(half , cx , cy , fx , fy)
		local hv = Holder.AbsoluteSize;

		if hv.X <= 0 or hv.Y <= 0 then
			return fx or 0.9 , fy or 0.15;
		end;

		local vp , ml , mt , mr , mb = safeRect();

		if cx ~= cx then cx = vp.X / 2; end;
		if cy ~= cy then cy = vp.Y / 2; end;

		local x = math.clamp(cx , ml + half.X , math.max(ml + half.X , vp.X - mr - half.X));
		local y = math.clamp(cy , mt + half.Y , math.max(mt + half.Y , vp.Y - mb - half.Y));

		return x / hv.X , y / hv.Y;
	end;

	local function moveTo(gui , c)
		local sx , sy = clampedScale(gui.AbsoluteSize / 2 , c.X , c.Y);

		gui.AnchorPoint = Vector2.new(0.5 , 0.5);
		gui.Position = UDim2.fromScale(sx , sy);

		return sx , sy;
	end;

	local function saveLayout(key , x , y)
		-- NaN и inf не кодируются в JSON и ломают весь конфиг: такие позиции не сохраняем
		if not (x == x and y == y) or x == math.huge or x == -math.huge or y == math.huge or y == -math.huge then
			return;
		end;

		Mobile.Layout[key] = { x = math.floor(x * 10000) / 10000 , y = math.floor(y * 10000) / 10000 };
	end;

	----------------------------------------------------------------- refresh
	function Mobile:Refresh()
		if not Holder then
			return;
		end;

		local on = NeverLose:IsMobileUI();
		local win = NeverLose.CurrentWindow;
		local menuOpen = win and win.Signal and win.Signal:GetValue() or false;
		local c = Cfg();
		local showFns = on and c.ShowFunctionButtons and (Mobile.Edit or not (c.HideWhenMenuOpen and menuOpen));

		Holder.Visible = on;

		if MenuBtn then
			MenuBtn.Visible = on and c.MenuButton;

			if MenuPaint then
				MenuPaint(menuOpen);
			end;
		end;

		if DonePill then
			DonePill.Visible = on and Mobile.Edit;
		end;

		for _ , b in next , Mobile.Buttons do
			b.Gui.Visible = showFns and (not b.Hidden or (Mobile.Edit and c.EditShowAll == true)) and b.Source.Mode ~= 'Always';
			b.Stroke.Thickness = Mobile.Edit and 1.5 or 1;
			b.Stroke.Color = Mobile.Edit and NeverLose.Theme.TextDim or (b.Source:GetState() and NeverLose.AccentColor or NeverLose.Theme.Stroke);
		end;
	end;

	----------------------------------------------------------------- function buttons: style / position / paint
	local function sizeOf(b)
		local v = b.Opts.Size or Cfg().ButtonSize;

		if type(v) == 'number' then
			return Vector2.new(v , v);
		elseif type(v) == 'table' then
			return Vector2.new(v[1] or v.X or v.Width or 76 , v[2] or v.Y or v.Height or 40);
		end;

		return v;
	end;

	local function styleButton(b)
		local c = Cfg();
		local size = sizeOf(b);
		local corner = b.Opts.Corner or c.ButtonCorner;
		local showMode = c.ShowMode ~= false;

		if b.Opts.ShowMode ~= nil then
			showMode = b.Opts.ShowMode and true or false; -- своё значение у конкретной кнопки
		end;

		local nameSize = showMode and math.clamp(math.floor(size.Y * 0.30) , 9 , 18) or math.clamp(math.floor(size.Y * 0.38) , 9 , 20);

		b.Gui.Size = UDim2.fromOffset(size.X , size.Y);
		b.Corner.CornerRadius = UDim.new(0 , math.min(corner , math.min(size.X , size.Y) / 2));
		b.NameLabel.TextSize = nameSize;
		b.NameLabel.Size = UDim2.new(1 , -8 , 0 , nameSize + 2);
		b.ModeLabel.Visible = showMode;
		b.ModeLabel.TextSize = math.max(nameSize - 1 , 9);
		b.ModeLabel.Size = UDim2.new(1 , -8 , 0 , math.max(nameSize - 1 , 9) + 2);
	end;

	local function positionButton(b)
		local c = Cfg();
		local size = sizeOf(b);
		local saved = Mobile.Layout[b.Key];

		b.Gui.AnchorPoint = Vector2.new(0.5 , 0.5);

		local hv = Holder.AbsoluteSize;
		local half = Vector2.new(size.X / 2 , size.Y / 2);
		local cx , cy = hv.X - (half.X + 10) , c.MenuButtonSize + 20 + half.Y + ((table.find(Mobile.Buttons , b) or 1) - 1) * (size.Y + 6);

		if saved and saved.x == saved.x and saved.y == saved.y then
			cx , cy = saved.x * hv.X , saved.y * hv.Y;
		end;

		local fsx , fsy = nil , nil;

		if saved and saved.x == saved.x and saved.y == saved.y then
			fsx , fsy = saved.x , saved.y;
		end;

		local sx , sy = clampedScale(half , cx , cy , fsx , fsy);

		b.Gui.Position = UDim2.fromScale(sx , sy);
	end;

	local function paintButton(b)
		local c = Cfg();
		local active = b.Source:GetState();

		b.NameLabel.Text = b.Source.Name or 'Keybind';
		b.ModeLabel.Text = b.Source.Mode or '';

		NeverLose.PlayAnimate(b.Gui , SlowyTween , {
			BackgroundColor3 = active and NeverLose.AccentColor or NeverLose.Theme.Deep2,
			BackgroundTransparency = active and 0.1 or c.Transparency,
		});

		b.Stroke.Color = Mobile.Edit and NeverLose.Theme.TextDim or (active and NeverLose.AccentColor or NeverLose.Theme.Stroke);
		b.Gui.Visible = b.Gui.Visible and b.Source.Mode ~= 'Always';
	end;

	-- показ кнопки по значению элемента (ShowWhen): тогл, дропдаун, Flag-строка
	local Watch = {};
	local WatchLoop = false;

	local function readShowWhen(b)
		local el = b.ShowWhen;

		if type(el) == 'string' then
			el = NeverLose.Flags[el];
		end;

		if type(el) ~= 'table' or type(el.GetValue) ~= 'function' then
			return true;
		end;

		local ok , cur = pcall(el.GetValue , el);

		if not ok then
			return true;
		end;

		local want = b.ShowValue;

		if type(want) == 'function' then
			local ok2 , r = pcall(want , cur);
			return ok2 and r and true or false;
		end;

		if type(cur) == 'table' then
			return cur[want] == true or table.find(cur , want) ~= nil;
		end;

		return cur == want;
	end;

	local function onHidden(b)
		if b.ResetOnHide and b.Source.SetState then
			b.Source:SetState(false);
		end;
	end;

	local function startWatch()
		if WatchLoop then
			return;
		end;

		WatchLoop = true;

		task.spawn(function()
			while #Watch > 0 do
				task.wait(0.1);

				local changed = false;

				for i = #Watch , 1 , -1 do
					local b = Watch[i];

					if not b.Gui or not b.Gui.Parent then
						table.remove(Watch , i);
					else
						local hidden = not readShowWhen(b);

						if hidden ~= b.Hidden then
							b.Hidden = hidden;
							changed = true;

							if hidden then
								onHidden(b);
							end;
						end;
					end;
				end;

				if changed then
					Mobile:Refresh();
				end;
			end;

			WatchLoop = false;
		end);
	end;

	function NeverLose:AddMobileButton(source , opts)
		opts = opts or {};

		ensureHolder();

		local b = {
			Source = source,
			Opts = opts,
			Key = opts.Key or source.Name or 'Keybind',
			Hidden = (opts.Visible == false),
			ShowWhen = opts.ShowWhen,
			ShowValue = (opts.ShowValue == nil) and true or opts.ShowValue,
			ResetOnHide = (opts.ResetOnHide ~= false),
		};

		if b.ShowWhen ~= nil then
			b.Hidden = not readShowWhen(b);
			table.insert(Watch , b);
			startWatch();
		end;

		local Gui = Instance.new('TextButton');
		local Corner = Instance.new('UICorner');
		local Stroke = Instance.new('UIStroke');
		local Layout = Instance.new('UIListLayout');
		local NameLabel = Instance.new('TextLabel');
		local ModeLabel = Instance.new('TextLabel');

		Gui.Name = NeverLose.RandomString();
		Gui.Parent = Holder;
		Gui.AutoButtonColor = false;
		Gui.BackgroundColor3 = NeverLose.Theme.Deep2;
		Gui.BackgroundTransparency = Cfg().Transparency;
		Gui.BorderSizePixel = 0;
		Gui.Text = '';
		Gui.ZIndex = 161;
		Gui.Visible = false;

		Corner.Parent = Gui;

		Stroke.Parent = Gui;
		Stroke.Color = NeverLose.Theme.Stroke;
		Stroke.Thickness = 1;
		Stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border;

		Layout.Parent = Gui;
		Layout.FillDirection = Enum.FillDirection.Vertical;
		Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center;
		Layout.VerticalAlignment = Enum.VerticalAlignment.Center;
		Layout.SortOrder = Enum.SortOrder.LayoutOrder;

		for i , l in next , { NameLabel , ModeLabel } do
			l.Name = NeverLose.RandomString();
			l.Parent = Gui;
			l.BackgroundTransparency = 1;
			l.BorderSizePixel = 0;
			l.Active = false;
			l.ZIndex = 162;
			l.Font = Enum.Font.GothamMedium;
			l.TextColor3 = NeverLose.Theme.Text;
			l.TextTruncate = Enum.TextTruncate.AtEnd;
			l.LayoutOrder = i;
		end;

		ModeLabel.TextTransparency = 0.4;

		b.Gui = Gui;
		b.Corner = Corner;
		b.Stroke = Stroke;
		b.NameLabel = NameLabel;
		b.ModeLabel = ModeLabel;

		table.insert(Mobile.Buttons , b);

		styleButton(b);
		positionButton(b);
		paintButton(b);

		-- нажатие = как клавиша; в режиме Edit кнопку можно двигать
		local startCenter = Vector2.zero;

		bindPointer(Gui ,
			function()
				if Mobile.Edit then
					startCenter = center(Gui);
				else
					source:Press();
				end;
			end ,
			function(delta)
				if Mobile.Edit then
					moveTo(Gui , startCenter + delta);
				end;
			end ,
			function()
				if Mobile.Edit then
					local c = center(Gui);
					local vp = Holder.AbsoluteSize;

					saveLayout(b.Key , c.X / vp.X , c.Y / vp.Y);
				else
					source:Release();
				end;
			end
		);

		b.Conn = NeverLose:AddSignal(source.Changed:Connect(function()
			paintButton(b);
			Mobile:Refresh();
		end));

		function b:SetSize(v)
			b.Opts.Size = v;
			styleButton(b);
			positionButton(b);
		end;

		function b:SetCorner(v)
			b.Opts.Corner = v;
			styleButton(b);
		end;

		function b:GetSize()
			return sizeOf(b);
		end;

		-- true: показывать Hold/Toggle, false: только название, nil: как в NeverLose.MobileConfig.ShowMode
		function b:SetShowMode(v)
			b.Opts.ShowMode = v;
			styleButton(b);
		end;

		-- показать / скрыть кнопку вручную (например из Callback тогла); отключает ShowWhen
		function b:SetVisible(v)
			local i = table.find(Watch , b);

			if i then
				table.remove(Watch , i);
			end;

			b.ShowWhen = nil;
			b.Hidden = not v;

			if b.Hidden then
				onHidden(b);
			end;

			Mobile:Refresh();
		end;

		function b:IsVisible()
			return not b.Hidden;
		end;

		function b:GetState()
			return source:GetState();
		end;

		function b:SetState(v)
			if source.SetState then
				source:SetState(v);
			end;
		end;

		function b:SetName(n)
			if source.SetName then
				source:SetName(n);
			end;
		end;

		function b:Destroy()
			local i = table.find(Watch , b);

			if i then
				table.remove(Watch , i);
			end;

			local j = table.find(Mobile.Buttons , b);

			if j then
				table.remove(Mobile.Buttons , j);
			end;

			if b.Conn then
				b.Conn:Disconnect();
			end;

			b.Gui:Destroy();
		end;

		Mobile:Refresh();

		return b;
	end;

	-- своя экранная кнопка: NeverLose:CreateMobileButton({ Name = 'Fly', Mode = 'Toggle', Callback = function(active) end })
	function NeverLose:CreateMobileButton(opts)
		opts = NeverLose:ProcessParams(opts , {
			Name = 'Button',
			Mode = 'Toggle',          -- 'Toggle' | 'Hold' | 'Button' (просто нажатие: Callback(true) один раз за тап)
			Default = false,
			Visible = true,
			ShowWhen = nil,           -- элемент (тогл/дропдаун) или имя Flag: кнопка видна, пока значение == ShowValue
			ShowValue = true,
			ResetOnHide = true,       -- кнопка скрылась -> состояние выключается (и вызывается Callback(false))
			Callback = EmptyFunction, -- function(active)
			Size = nil,               -- Vector2: свой размер
			Corner = nil,             -- число: своё закругление
			ShowMode = nil,           -- true/false: показывать Hold/Toggle на этой кнопке (nil = общая настройка)
			Flag = nil,               -- ключ для сохранения позиции (по умолчанию Name)
		});

		local source = {
			Name = opts.Name,
			Mode = (opts.Mode == 'Hold' and 'Hold') or (opts.Mode == 'Button' and 'Button') or 'Toggle',
			Active = (opts.Mode ~= 'Button') and (opts.Default and true or false),
			Changed = NeverLose:CreateSignal(0),
		};

		local function fire()
			source.Changed:SetValue(source.Changed:GetValue() + 1);
		end;

		local function setState(v)
			v = v and true or false;

			if source.Active == v then
				return;
			end;

			source.Active = v;
			fire();
			task.spawn(opts.Callback , v);
		end;

		function source:GetState()
			return source.Active;
		end;

		function source:SetState(v)
			if source.Mode == 'Button' then
				return; -- у режима Button нет состояния
			end;

			setState(v);
		end;

		function source:Press()
			if source.Mode == 'Button' then
				-- обычная кнопка: один вызов за нажатие + короткая подсветка
				task.spawn(opts.Callback , true);

				source.Active = true;
				fire();

				task.delay(0.15 , function()
					source.Active = false;
					fire();
				end);
			elseif source.Mode == 'Toggle' then
				setState(not source.Active);
			else
				setState(true);
			end;
		end;

		function source:Release()
			if source.Mode == 'Hold' and source.Active then
				setState(false);
			end;
		end;

		function source:SetName(n)
			source.Name = n;
			fire();
		end;

		local b = NeverLose:AddMobileButton(source , {
			Size = opts.Size,
			Corner = opts.Corner,
			Key = opts.Flag or opts.Name,
			ShowMode = opts.ShowMode,
			Visible = opts.Visible,
			ShowWhen = opts.ShowWhen,
			ShowValue = opts.ShowValue,
			ResetOnHide = opts.ResetOnHide,
		});

		if source.Active then
			task.spawn(opts.Callback , true);
		end;

		return b;
	end;

	function Mobile:Restyle()
		for _ , b in next , Mobile.Buttons do
			styleButton(b);
			positionButton(b);
			paintButton(b);
		end;

		if MenuBtn then
			Mobile:StyleMenuButton();
		end;

		Mobile:Refresh();
	end;

	-- иконка кнопки меню: текст, иконка библиотеки или картинка
	function Mobile:ApplyMenuIcon()
		if not MenuBtn then
			return;
		end;

		local c = Cfg();
		local icon = c.MenuButtonIcon;
		local px = math.max(8 , math.floor(c.MenuButtonSize * (c.MenuButtonIconScale or 0.55)));
		local color = c.MenuButtonIconColor or Color3.fromRGB(255 , 255 , 255);
		local imageId = nil;

		if type(icon) == 'number' then
			imageId = 'rbxassetid://' .. icon;
		elseif type(icon) == 'string' then
			if string.match(icon , '^%d+$') then
				imageId = 'rbxassetid://' .. icon;
			elseif string.match(icon , '^rbxassetid://') or string.match(icon , '^rbxasset://') or string.match(icon , '^https?://') then
				imageId = icon;
			end;
		end;

		if imageId then
			FillMode = (c.MenuButtonStyle or 'Auto') ~= 'Default';

			MenuBtn.Icon.Visible = false;
			MenuBtn.Image.Visible = true;
			MenuBtn.Image.Image = imageId;
			MenuBtn.Image.ImageColor3 = c.MenuButtonIconColor or Color3.fromRGB(255 , 255 , 255);

			if FillMode then
				MenuBtn.Image.Size = UDim2.new(1 , 0 , 1 , 0);
				local r = math.min(c.MenuButtonFillCorner or math.floor(c.MenuButtonSize * 0.25) , c.MenuButtonSize / 2);

				MenuBtn.ImageCorner.CornerRadius = UDim.new(0 , r);
				MenuBtn.Corner.CornerRadius = UDim.new(0 , r); -- рамка и свечение повторяют форму иконки
			else
				MenuBtn.Image.Size = UDim2.fromOffset(px , px);
				MenuBtn.ImageCorner.CornerRadius = UDim.new(0 , 0);
				MenuBtn.Corner.CornerRadius = UDim.new(0 , math.min(c.MenuButtonCorner , c.MenuButtonSize / 2));
			end;
		else
			FillMode = false;
			local text = tostring(icon or 'N');

			MenuBtn.Corner.CornerRadius = UDim.new(0 , math.min(c.MenuButtonCorner , c.MenuButtonSize / 2));
			MenuBtn.Image.Visible = false;
			MenuBtn.Icon.Visible = true;
			MenuBtn.Icon.TextColor3 = color;
			MenuBtn.Icon.TextSize = px;

			if string.sub(text , 1 , 5) == 'icon:' then
				NeverLose:SetIconMode(MenuBtn.Icon , string.sub(text , 6)); -- иконка библиотеки, '-bold' на конце = жирная
			else
				MenuBtn.Icon.Font = Enum.Font.GothamBold;
				MenuBtn.Icon.Text = text;
			end;
		end;

		-- перекрашиваем кнопку под текущий режим и состояние меню
		if MenuPaint then
			local win = NeverLose.CurrentWindow;

			MenuPaint(win and win.Signal and win.Signal:GetValue() or false);
		end;
	end;

	----------------------------------------------------------------- menu button
	function Mobile:StyleMenuButton()
		local c = Cfg();

		MenuBtn.Size = UDim2.fromOffset(c.MenuButtonSize , c.MenuButtonSize);
		MenuBtn.Corner.CornerRadius = UDim.new(0 , math.min(c.MenuButtonCorner , c.MenuButtonSize / 2));
		Mobile:ApplyMenuIcon();

		local saved = Mobile.Layout.__menu;

		MenuBtn.AnchorPoint = Vector2.new(0.5 , 0.5);

		local hv = Holder.AbsoluteSize;
		local half = Vector2.new(c.MenuButtonSize / 2 , c.MenuButtonSize / 2);
		local cx , cy = hv.X - (half.X + 8) , half.Y + 10;

		if saved and saved.x == saved.x and saved.y == saved.y then
			cx , cy = saved.x * hv.X , saved.y * hv.Y;
		end;

		local fsx , fsy = nil , nil;

		if saved and saved.x == saved.x and saved.y == saved.y then
			fsx , fsy = saved.x , saved.y;
		end;

		local sx , sy = clampedScale(half , cx , cy , fsx , fsy);

		MenuBtn.Position = UDim2.fromScale(sx , sy);
	end;

	-- вернуть все экранные кнопки (и кнопку меню) в безопасную зону
	function Mobile:ClampAll()
		if not Holder or not MenuBtn or (Mobile.Busy or 0) > 0 then
			return;
		end;

		local hv = Holder.AbsoluteSize;

		if hv.X <= 0 or hv.Y <= 0 then
			return;
		end;

		local function fix(gui)
			local p = gui.Position;
			local sx , sy = clampedScale(gui.AbsoluteSize / 2 , p.X.Scale * hv.X + p.X.Offset , p.Y.Scale * hv.Y + p.Y.Offset);

			if math.abs(sx - p.X.Scale) > 0.0005 or math.abs(sy - p.Y.Scale) > 0.0005 or p.X.Offset ~= 0 or p.Y.Offset ~= 0 then
				gui.AnchorPoint = Vector2.new(0.5 , 0.5);
				gui.Position = UDim2.fromScale(sx , sy);
			end;
		end;

		fix(MenuBtn.Gui);

		for _ , b in next , Mobile.Buttons do
			if b.Gui and b.Gui.Parent then
				fix(b.Gui);
			end;
		end;
	end;

	-- вернуть кнопку меню на место по умолчанию (на случай, если сохранённая позиция плохая)
	function NeverLose:ResetMobileMenuButton()
		Mobile.Layout.__menu = nil;

		if MenuBtn then
			Mobile:StyleMenuButton();
		end;
	end;

